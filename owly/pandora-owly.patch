+// ---- pandora: admit only peers that talk to us ----
+//
+// owly reports every AWDL node it hears (idle Macs, watches, iPads...). The peach driver has 8 remote
+// peer slots; filling them with idle neighbours left no slot for the iPhone actually sharing (ENOSPC),
+// and add/del churn across many peers wedged the PT close path (and once crashed the firmware). The gate
+// keeps AWDL peers as candidates and adds a peer to the driver only after it sent us a data frame:
+// unicast to our address, or a multicast _airdrop mDNS query (share sheet browsing). At most
+// OWLY_PEER_MAX (default 6) peers hold slots. Peers receiving our unicast win over multicast-only ones,
+// and a unicast peer that owly drops keeps its slot for 30 s so a short owly timeout mid-transfer does
+// not stall the upload. OWLY_PEER_GATE=0 restores the original admit-everything behaviour.
+
+const GATE_ACTIVE_WINDOW: Duration = Duration::from_secs(30);
+const GATE_UNICAST_WINDOW: Duration = Duration::from_secs(30);
+const GATE_EVICT_IDLE: Duration = Duration::from_secs(15);
+const GATE_LINGER: Duration = Duration::from_secs(30);
+const GATE_READD_COOLDOWN: Duration = Duration::from_secs(5);
+const GATE_OP_SPACING: Duration = Duration::from_millis(300);
+
+static GATE: std::sync::OnceLock<Arc<PeerGate>> = std::sync::OnceLock::new();
+
+struct GateState {
+    candidates: std::collections::HashMap<MacAddr, Option<PeerCaps>>,
+    active: std::collections::HashMap<MacAddr, Instant>,
+    unicast: std::collections::HashMap<MacAddr, Instant>,
+    lingering: std::collections::HashMap<MacAddr, Instant>,
+    released: std::collections::HashMap<MacAddr, Instant>,
+    last_op: Option<Instant>,
+    admitted: Vec<MacAddr>,
+    full_logged: Option<Instant>,
+}
+
+impl GateState {
+    fn recent(map: &std::collections::HashMap<MacAddr, Instant>, mac: &MacAddr, window: Duration) -> bool {
+        map.get(mac).is_some_and(|t| t.elapsed() < window)
+    }
+}
+
+pub struct PeerGate {
+    bus: Arc<SyncBus>,
+    max: usize,
+    state: Mutex<GateState>,
+}
+
+impl PeerGate {
+    fn install(bus: &Arc<SyncBus>) -> Option<Arc<PeerGate>> {
+        if std::env::var("OWLY_PEER_GATE").is_ok_and(|v| v == "0") {
+            println!("OWLY_PEER_GATE enabled=false");
+            return None;
+        }
+        let max = std::env::var("OWLY_PEER_MAX")
+            .ok()
+            .and_then(|v| v.parse::<usize>().ok())
+            .unwrap_or(6)
+            .clamp(1, 8);
+        let gate = Arc::new(PeerGate {
+            bus: Arc::clone(bus),
+            max,
+            state: Mutex::new(GateState {
+                candidates: std::collections::HashMap::new(),
+                active: std::collections::HashMap::new(),
+                unicast: std::collections::HashMap::new(),
+                lingering: std::collections::HashMap::new(),
+                released: std::collections::HashMap::new(),
+                last_op: None,
+                admitted: Vec::new(),
+                full_logged: None,
+            }),
+        });
+        let _ = GATE.set(Arc::clone(&gate));
+        println!("OWLY_PEER_GATE enabled=true max={max} linger_s=30");
+        Some(gate)
+    }
+
+    fn release(&self, st: &mut GateState, mac: MacAddr, why: &str) {
+        st.admitted.retain(|m| *m != mac);
+        st.lingering.remove(&mac);
+        st.released.insert(mac, Instant::now());
+        st.last_op = Some(Instant::now());
+        raw_peer_down(&self.bus, mac);
+        println!("OWLY_PEER_GATE {why} {mac} admitted={}", st.admitted.len());
+    }
+
+    fn sweep(&self, st: &mut GateState) {
+        let expired: Vec<MacAddr> = st
+            .lingering
+            .iter()
+            .filter(|(_, t)| t.elapsed() >= GATE_LINGER)
+            .map(|(m, _)| *m)
+            .collect();
+        for m in expired {
+            self.release(st, m, "linger-expired");
+        }
+    }
+
+    fn up(&self, mac: MacAddr, caps: Option<PeerCaps>) {
+        let mut st = self.state.lock().unwrap();
+        self.sweep(&mut st);
+        st.candidates.insert(mac, caps);
+        if st.lingering.remove(&mac).is_some() {
+            println!("OWLY_PEER_GATE resume {mac}");
+        }
+        if st.admitted.contains(&mac) {
+            raw_set_peer_up(&self.bus, mac, caps);
+            return;
+        }
+        if GateState::recent(&st.active, &mac, GATE_ACTIVE_WINDOW) {
+            let uni = GateState::recent(&st.unicast, &mac, GATE_UNICAST_WINDOW);
+            self.try_admit(&mut st, mac, uni);
+        }
+    }
+
+    fn caps(&self, mac: MacAddr, caps: PeerCaps) {
+        let mut st = self.state.lock().unwrap();
+        if let Some(c) = st.candidates.get_mut(&mac) {
+            *c = Some(caps);
+        }
+        if st.admitted.contains(&mac) && !st.lingering.contains_key(&mac) {
+            raw_peer_caps(&self.bus, mac, caps);
+        }
+    }
+
+    fn down(&self, mac: MacAddr) {
+        let mut st = self.state.lock().unwrap();
+        st.candidates.remove(&mac);
+        if !st.admitted.contains(&mac) {
+            st.active.remove(&mac);
+            st.unicast.remove(&mac);
+            return;
+        }
+        if GateState::recent(&st.unicast, &mac, GATE_UNICAST_WINDOW) {
+            st.lingering.insert(mac, Instant::now());
+            println!("OWLY_PEER_GATE linger {mac} admitted={}", st.admitted.len());
+            return;
+        }
+        st.active.remove(&mac);
+        st.unicast.remove(&mac);
+        self.release(&mut st, mac, "drop");
+    }
+
+    fn data(&self, mac: MacAddr, unicast: bool) {
+        let mut st = self.state.lock().unwrap();
+        let now = Instant::now();
+        st.active.insert(mac, now);
+        if unicast {
+            st.unicast.insert(mac, now);
+        }
+        if st.admitted.contains(&mac) || !st.candidates.contains_key(&mac) {
+            return;
+        }
+        self.sweep(&mut st);
+        self.try_admit(&mut st, mac, unicast);
+    }
+
+    fn try_admit(&self, st: &mut GateState, mac: MacAddr, unicast: bool) {
+        st.released.retain(|_, t| t.elapsed() < GATE_READD_COOLDOWN);
+        if st.released.contains_key(&mac) {
+            return; // its previous driver peer may still be tearing down
+        }
+        if st.last_op.is_some_and(|t| t.elapsed() < GATE_OP_SPACING) {
+            return; // retried on the next data frame (throttled to 500 ms per MAC)
+        }
+        if st.admitted.len() >= self.max {
+            let now = Instant::now();
+            // victim order: lingering first, then multicast-only, then by longest idle
+            let victim = st
+                .admitted
+                .iter()
+                .copied()
+                .map(|m| {
+                    let idle = st.active.get(&m).map_or(Duration::MAX, |t| now.duration_since(*t));
+                    let uni = GateState::recent(&st.unicast, &m, GATE_UNICAST_WINDOW);
+                    let ling = st.lingering.contains_key(&m);
+                    (ling, !uni, idle, m)
+                })
+                .max_by_key(|(ling, multi_only, idle, _)| (*ling, *multi_only, *idle));
+            let evictable = match victim {
+                Some((true, _, idle, _)) => idle >= Duration::from_secs(5),
+                Some((false, true, idle, _)) => unicast || idle >= GATE_EVICT_IDLE,
+                Some((false, false, idle, _)) => idle >= GATE_EVICT_IDLE,
+                None => false,
+            };
+            match victim {
+                Some((_, _, idle, v)) if evictable => {
+                    let _ = idle;
+                    self.release(st, v, "evict");
+                }
+                _ => {
+                    if st.full_logged.is_none_or(|t| t.elapsed() > Duration::from_secs(5)) {
+                        st.full_logged = Some(now);
+                        println!("OWLY_PEER_GATE full skip={mac} unicast={unicast} admitted={}", st.admitted.len());
+                    }
+                    return;
+                }
+            }
+        }
+        let caps = st.candidates.get(&mac).copied().flatten();
+        st.admitted.push(mac);
+        st.last_op = Some(Instant::now());
+        raw_set_peer_up(&self.bus, mac, caps);
+        println!("OWLY_PEER_GATE admit {mac} unicast={unicast} admitted={}", st.admitted.len());
+    }
+}
+
+/// Called from the air RX path (throttled per MAC by the caller) for data frames meant for us.
+pub fn note_peer_data(mac: MacAddr, unicast: bool) {
+    if let Some(g) = GATE.get() {
+        g.data(mac, unicast);
+    }
+}
