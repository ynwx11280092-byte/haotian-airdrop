+/// pandora peer gate: true if an AWDL data frame carries IPv6 TCP or UDP (AirDrop traffic), not ICMPv6
+/// (owly keepalive pings and their replies, NDP), which every neighbour answers.
+fn carries_tcp_udp(raw: &[u8]) -> bool {
+    let lim = raw.len().min(96);
+    for i in 24..lim.saturating_sub(10) {
+        if raw[i] == 0x86 && raw[i + 1] == 0xdd && raw[i + 2] >> 4 == 6 {
+            let nh = raw[i + 2 + 6];
+            return nh == 6;
+        }
+    }
+    false
+}
