+static unsigned int wma_pt_recent_del_next;
+
+/* Caller holds wma_pt_peer_lock. */
+static void wma_pt_note_deleted_locked(const u8 *mac)
+{
+	unsigned int i = wma_pt_recent_del_next++ % WMA_PT_MAX_PEERS;
+
+	memcpy(wma_pt_recent_del[i].mac, mac, QDF_MAC_ADDR_SIZE);
+	wma_pt_recent_del[i].when = jiffies;
+	wma_pt_recent_del[i].used = true;
+}
+
+/* Caller holds wma_pt_peer_lock. */
+static bool wma_pt_recently_deleted_locked(const u8 *mac)
+{
+	int i;
+
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		if (wma_pt_recent_del[i].used &&
+		    !memcmp(wma_pt_recent_del[i].mac, mac, QDF_MAC_ADDR_SIZE) &&
+		    time_before(jiffies, wma_pt_recent_del[i].when +
+				msecs_to_jiffies(WMA_PT_READD_HOLD_MS)))
+			return true;
+	}
+	return false;
+}
