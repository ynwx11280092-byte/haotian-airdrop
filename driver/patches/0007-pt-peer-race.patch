+		.peer_tid_bitmap = U32_MAX & ~BIT(WMI_MGMT_TID),
+		.vdev_id = vdev_id,
+	};
+	struct peer_delete_cmd_params del = { .vdev_id = vdev_id };
+	struct wlan_objmgr_vdev *vdev = wma->interfaces[vdev_id].vdev;
