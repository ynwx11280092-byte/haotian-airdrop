+bool pt_remote_peer_commit_auth(u64 peer_seq, u16 peer_id,
+				void (*authorize)(void *), void *peer)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+	bool committed = false;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_seq(peer_seq);
+	if (slot && slot->active && slot->peer_id == peer_id &&
+	    slot->htt_map && slot->slot_installed && slot->ast_valid &&
+	    slot->assoc_confirmed && !slot->assoc_status &&
+	    !slot->dp_conflict && !slot->delete_issued) {
+		authorize(peer);
+		slot->setup_rc = 0;
+		wma_pt_set_tx_ready_locked(slot, true);
+		wma_pt_peer_last = *slot;
+		committed = true;
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return committed;
+}
