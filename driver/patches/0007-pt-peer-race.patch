+/* pandora: stop DP TX to a peer whose DP/firmware state diverged from the host slot. */
+static void wma_pt_slot_conflict_locked(struct wma_pt_peer_state *slot)
+{
+	slot->dp_conflict = true;
+	wma_pt_set_tx_ready_locked(slot, false);
