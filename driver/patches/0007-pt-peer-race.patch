+	if (!wmi_service_enabled(wma->wmi_handle,
+				 wmi_service_peer_delete_no_peer_flush_tids_cmd))
+		wmi_unified_peer_flush_tids_send(wma->wmi_handle, peer_addr, &flush);
+	wlan_roam_debug_log(vdev_id, DEBUG_PEER_DELETE_SEND,
+			    DEBUG_INVALID_PEER_ID, peer_addr, NULL, 0, 0);
+	del.is_mlo_link_switch =
+		wlan_vdev_mlme_is_mlo_link_switch_in_progress(vdev);
+	return wmi_unified_peer_delete_send(wma->wmi_handle, peer_addr, &del);
+}
