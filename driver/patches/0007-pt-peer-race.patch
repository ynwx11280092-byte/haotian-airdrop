+static bool wma_pt_create_rejected(const struct wma_pt_peer_state *slot)
+{
+	/* A map contradicts a failed create. Require a firmware delete then. */
+	if (!slot->create_returned || slot->htt_map ||
+	    slot->slot_installed || slot->ast_valid)
+		return false;
+	if (slot->create_confirmed)
+		return slot->create_status != 0;
+	return QDF_IS_STATUS_ERROR(slot->create_submit);
+}
+
+static bool wma_pt_delete_complete(const struct wma_pt_peer_state *slot)
+{
+	return slot->dp_released && slot->obj_released &&
+	       (wma_pt_create_rejected(slot) || slot->delete_confirmed) &&
+	       (!slot->slot_installed ||
+		(slot->htt_unmap && slot->slot_removed));
+}
