+
+bool dp_pt_remote_peer_authorize(struct cdp_soc_t *soc_hdl, u8 vdev_id,
+				const u8 *mac, u16 peer_id, u64 peer_seq)
+{
+	struct dp_soc *soc = cdp_soc_t_to_dp_soc(soc_hdl);
+	struct dp_peer *peer;
+	bool committed = false;
+
+	if (peer_id == HTT_INVALID_PEER || peer_id > soc->max_peer_id)
+		return false;
+
+	/* The map holds the DP reference. Use map -> peer state -> WMA order. */
+	qdf_spin_lock_bh(&soc->peer_map_lock);
+	peer = soc->peer_id_to_obj_map[peer_id];
+	if (peer && peer->peer_id == peer_id && peer->vdev &&
+	    peer->vdev->vdev_id == vdev_id &&
+	    !qdf_mem_cmp(peer->mac_addr.raw, mac, QDF_MAC_ADDR_SIZE)) {
+		qdf_spin_lock_bh(&peer->peer_state_lock);
+		if (peer->valid && peer->peer_state == DP_PEER_STATE_ACTIVE &&
+		    peer->txrx_peer && !IS_MLO_DP_LINK_PEER(peer))
+			committed = pt_remote_peer_commit_auth(peer_seq, peer_id,
+							      dp_pt_authorize,
+							      peer);
+		qdf_spin_unlock_bh(&peer->peer_state_lock);
+	}
+	qdf_spin_unlock_bh(&soc->peer_map_lock);
+	return committed;
+}
+#endif
