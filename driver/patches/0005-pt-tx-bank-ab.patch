diff --git a/qca-wifi-host-cmn/dp/wifi3.0/be/dp_be_tx.c b/qca-wifi-host-cmn/dp/wifi3.0/be/dp_be_tx.c
index f2ea398..de385fe 100644
--- a/qca-wifi-host-cmn/dp/wifi3.0/be/dp_be_tx.c
+++ b/qca-wifi-host-cmn/dp/wifi3.0/be/dp_be_tx.c
@@ -2214,9 +2214,20 @@ void dp_tx_put_bank_profile(struct dp_soc_be *be_soc,
 void dp_tx_update_bank_profile(struct dp_soc_be *be_soc,
 			       struct dp_vdev_be *be_vdev)
 {
+	bool passthru = dp_tx_vdev_is_passthru(&be_vdev->vdev);
+	int old_bank = be_vdev->bank_id;
+	uint8_t old_pmac = passthru ?
+		be_soc->bank_profiles[old_bank].bank_config.pmac_id : 0;
+
 	dp_tx_put_bank_profile(be_soc, be_vdev);
 	be_vdev->bank_id = dp_tx_get_bank_profile(be_soc, be_vdev);
 	be_vdev->vdev.bank_id = be_vdev->bank_id;
+
+	if (passthru && be_vdev->bank_id != DP_BE_INVALID_BANK_ID)
+		pr_info("PT_TX_BANK vdev=%u desc_pmac=%u bank=%d->%d bank_pmac=%u->%u\n",
+			be_vdev->vdev.vdev_id, be_vdev->vdev.lmac_id,
+			old_bank, be_vdev->bank_id, old_pmac,
+			be_soc->bank_profiles[be_vdev->bank_id].bank_config.pmac_id);
 }
 
