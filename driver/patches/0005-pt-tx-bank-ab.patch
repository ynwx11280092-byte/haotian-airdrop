 }
 
+#ifdef DRIVER_PASSTHRU_DP
+static bool pt_sync_tx_bank;
+module_param(pt_sync_tx_bank, bool, 0400);
+MODULE_PARM_DESC(pt_sync_tx_bank, "Refresh the PASSTHRU TX bank after LMAC sync");
+#endif
+
 /**
  * dp_vdev_update_lmacid() - update mac_id for vdev
  * @soc_hdl: Datapath soc handle
@@ -12985,6 +12991,16 @@ dp_vdev_update_lmacid(struct cdp_soc_t *soc_hdl,
 
 	pr_info("PT_LMAC dp vdev %u lmac %u -> %u\n", vdev_id, vdev->lmac_id, lmac_id);
 	vdev->lmac_id = lmac_id;
+#ifdef DRIVER_PASSTHRU_DP
+	if (pt_sync_tx_bank && soc->arch_id == CDP_ARCH_TYPE_BE &&
+	    dp_tx_vdev_is_passthru(vdev)) {
+		cdp_config_param_type config = {0};
+
+		/* BE refreshes the raw TX bank using the current vdev state. */
+		soc->arch_ops.txrx_set_vdev_param(soc, vdev,
+						CDP_ENABLE_CIPHER, config);
+	}
+#endif
 	if (wlan_op_mode_monitor == vdev->opmode)
 		dp_monitor_update_mac_vdev_map(vdev);
 	dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_CDP);
