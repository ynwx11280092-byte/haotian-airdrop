+#ifdef DRIVER_PASSTHRU_OWNER
+QDF_STATUS dp_tx_passthru_pool_map(struct dp_vdev *vdev)
+{
+	struct dp_soc *soc = vdev->pdev->soc;
+	uint32_t count = wlan_cfg_get_num_tx_desc(soc->wlan_cfg_ctx);
+	struct dp_tx_desc_pool_s *pool;
+
+	if (!count || vdev->vdev_id >= MAX_TXDESC_POOLS)
+		return QDF_STATUS_E_INVAL;
+	pool = dp_tx_create_flow_pool_internal(soc, vdev->vdev_id, count, vdev);
+	if (!pool)
+		return QDF_STATUS_E_RESOURCES;
+	soc->pool_stats.pool_map_count++;
+	dp_info("PT mapped TX pool %u size %u", vdev->vdev_id, pool->pool_size);
+	return QDF_STATUS_SUCCESS;
+}
+
+/* Exact-owner release: no ID lookup, no reattach and no MLO policy lookup.
+ * The final vdev ref remains held across this call. A pending completion
+ * retains only an INVALID pool reservation, never a dangling vdev pointer.
+ */
+void dp_tx_passthru_pool_unmap(struct dp_vdev *vdev)
+{
+	struct dp_soc *soc = vdev->pdev->soc;
+	struct dp_tx_desc_pool_s *pool;
+
+	if (vdev->vdev_id >= MAX_TXDESC_POOLS)
+		return;
+	pool = &soc->tx_desc[vdev->vdev_id];
+	qdf_spin_lock_bh(&pool->flow_pool_lock);
+	if (pool->passthru_owner != vdev || vdev->pool != pool ||
+	    pool->pool_create_cnt != 1) {
+		qdf_spin_unlock_bh(&pool->flow_pool_lock);
+		return;
+	}
+	vdev->pool = NULL;
+	pool->passthru_owner = NULL;
+	pool->pool_create_cnt = 0;
+	soc->pool_stats.pool_unmap_count++;
+	if (pool->avail_desc < pool->pool_size) {
+		pool->passthru_retiring = true;
+		pool->status = FLOW_POOL_INVALID;
+		qdf_spin_unlock_bh(&pool->flow_pool_lock);
+		/* Existing completion frees INVALID pools after the last return. */
+		dp_tx_desc_flush(vdev->pdev, vdev, false);
+		return;
+	}
+	dp_tx_desc_pool_deinit(soc, vdev->vdev_id, false);
+	dp_tx_desc_pool_free(soc, vdev->vdev_id, false);
+	qdf_spin_unlock_bh(&pool->flow_pool_lock);
+}
+#endif
