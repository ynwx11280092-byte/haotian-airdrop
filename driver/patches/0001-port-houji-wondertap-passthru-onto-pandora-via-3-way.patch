+static struct wma_pt_peer_state *wma_pt_find_slot_seq(u64 peer_seq)
+{
+	int i;
+
+	if (!peer_seq)
+		return NULL;
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		if (wma_pt_peers[i].peer_seq == peer_seq)
+			return &wma_pt_peers[i];
+	}
+	return NULL;
+}
