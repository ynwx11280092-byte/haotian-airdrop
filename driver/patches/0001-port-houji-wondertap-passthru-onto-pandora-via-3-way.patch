+/*
+ * Caller holds a real DP vdev reference. A successful OSIF invocation always
+ * consumes nbuf, including OSIF error returns. Pre-call failures leave it to
+ * the caller. The registration owner retains OSIF context through delete_notify.
+ */
+static QDF_STATUS
+dp_rx_deliver_raw_passthru(struct dp_soc *soc, struct dp_vdev *vdev,
+			  qdf_nbuf_t nbuf)
+{
+	uint8_t *rx_tlvs;
+	uint32_t tlv_len, prefix, raw_len = 0, raw_capacity = 0;
+	QDF_STATUS status = QDF_STATUS_E_FAILURE;
+	bool fcs_error, metadata = false;
+	uint64_t rx_ticks = 0;
+	int8_t signal = 0;
+
+	if (!dp_passthru_enter(vdev))
+		return status;
+
+	if (!nbuf || !vdev->osif_rx || !vdev->osif_vdev ||
+	    vdev->delete.pending || !vdev->passthru_freq ||
+	    qdf_nbuf_is_nonlinear(nbuf) || qdf_nbuf_is_frag(nbuf) ||
+	    qdf_nbuf_is_rx_chfrag_cont(nbuf) ||
+	    !qdf_nbuf_is_rx_chfrag_start(nbuf) ||
+	    !qdf_nbuf_is_rx_chfrag_end(nbuf) || qdf_nbuf_len(nbuf) < 10)
+		goto out;
+
+	tlv_len = soc->rx_pkt_tlv_size;
+	prefix = tlv_len + QDF_NBUF_CB_RX_PACKET_L3_HDR_PAD(nbuf);
+	if (!hal_rx_passthru_tlv_size_valid(soc->hal_soc, tlv_len) ||
+	    qdf_nbuf_headroom(nbuf) < prefix)
+		goto out;
+
+	/* The validated descriptor remains in headroom until radiotap is added. */
+	rx_tlvs = qdf_nbuf_data(nbuf) - prefix;
+	if (!HAL_IS_DECAP_FORMAT_RAW(soc->hal_soc, rx_tlvs))
+		goto out;
+	fcs_error = !!hal_rx_tlv_mpdu_fcs_err_get(soc->hal_soc, rx_tlvs);
+	pt_rx_phy_record(soc, vdev, nbuf, rx_tlvs, tlv_len, fcs_error);
+	if (!fcs_error && qdf_nbuf_len(nbuf) >= 26 &&
+	    (qdf_nbuf_data(nbuf)[0] & 0xfc) == 0x88 &&
+	    wlan_cfg_rx_buffer_size(soc->wlan_cfg_ctx) == WLAN_CFG_PT_RX_CAPACITY) {
+		raw_len = qdf_nbuf_len(nbuf);
+		raw_capacity = raw_len + qdf_nbuf_tailroom(nbuf) + prefix;
+	}
+    if (dp_rx_passthru_metadata)
+        metadata = hal_rx_passthru_kiwi_metadata(soc->hal_soc, rx_tlvs,
+                                                 tlv_len, &rx_ticks, &signal);
+    if (!qdf_nbuf_update_radiotap_passthru(nbuf, vdev->passthru_freq,
+                                         fcs_error, metadata,
+                                         rx_ticks / 960, signal))
+		goto out;
+
+	if (raw_len)
+		pr_info_once("PT_RX_CAPACITY raw_osif_bytes=%u tlv=%u pad=%u linear_span=%u\n",
+			     raw_len, tlv_len, prefix - tlv_len, raw_capacity);
+
+	/* Do not inspect nbuf or interpret the status as retained ownership. */
+	vdev->osif_rx(vdev->osif_vdev, nbuf);
+	status = QDF_STATUS_SUCCESS;
+out:
+	dp_passthru_exit(vdev);
+	return status;
+}
+
+/*
+ * RX error-ring single MSDU-buffer adapter. Caller has unmapped DMA, detached
+ * the RX descriptor, and holds a DP vdev reference. Always consumes nbuf.
+ * Only bounded, complete RAW frames are eligible for OSIF delivery.
+ */
+enum dp_pt_rx_msdu_result
+dp_rx_passthru_msdu_buf_deliver(struct dp_soc *soc, struct dp_vdev *vdev,
+				   qdf_nbuf_t nbuf, uint32_t mapped_size)
+{
+	enum dp_pt_rx_msdu_result result = DP_PT_RX_MSDU_BAD_SHAPE;
+	uint8_t *tlvs;
+	uint32_t capacity, pad, prefix, msdu_len, pkt_len;
+
+	if (qdf_nbuf_is_nonlinear(nbuf) || qdf_nbuf_is_frag(nbuf) ||
+	    qdf_nbuf_is_rx_chfrag_cont(nbuf) || qdf_nbuf_next(nbuf))
+		goto drop;
+	result = DP_PT_RX_MSDU_BAD_TLV_SIZE;
+	capacity = qdf_nbuf_len(nbuf) + qdf_nbuf_tailroom(nbuf);
+	capacity = qdf_min(capacity, mapped_size);
+	if (!hal_rx_passthru_tlv_size_valid(soc->hal_soc, soc->rx_pkt_tlv_size) ||
+	    capacity < soc->rx_pkt_tlv_size)
+		goto drop;
+	result = DP_PT_RX_MSDU_BAD_TLV_FLAGS;
+	tlvs = qdf_nbuf_data(nbuf);
+	if (!hal_rx_attn_msdu_done_get(soc->hal_soc, tlvs) ||
+	    !HAL_IS_DECAP_FORMAT_RAW(soc->hal_soc, tlvs) ||
+	    !hal_rx_msdu_end_first_msdu_get(soc->hal_soc, tlvs) ||
+	    !hal_rx_msdu_end_last_msdu_get(soc->hal_soc, tlvs))
+		goto drop;
+	result = DP_PT_RX_MSDU_BAD_LENGTH;
+	pad = hal_rx_msdu_end_l3_hdr_padding_get(soc->hal_soc, tlvs);
+	msdu_len = hal_rx_msdu_start_msdu_len_get(soc->hal_soc, tlvs);
+	prefix = soc->rx_pkt_tlv_size + pad;
+	if (prefix < soc->rx_pkt_tlv_size || prefix > capacity ||
+	    msdu_len < 10 || msdu_len > capacity - prefix)
+		goto drop;
+	pkt_len = prefix + msdu_len;
+	if (dp_rx_check_pkt_len(soc, pkt_len))
+		goto drop;
+	qdf_nbuf_set_pktlen(nbuf, pkt_len);
+	qdf_nbuf_set_next(nbuf, NULL);
+	qdf_nbuf_set_rx_chfrag_start(nbuf, 1);
+	qdf_nbuf_set_rx_chfrag_end(nbuf, 1);
+	dp_rx_skip_tlvs(soc, nbuf, pad);
+	result = DP_PT_RX_MSDU_OSIF_REJECTED;
+	if (!QDF_IS_STATUS_ERROR(dp_rx_deliver_raw_passthru(soc, vdev, nbuf)))
+		return DP_PT_RX_MSDU_DELIVERED;
+drop:
+	dp_rx_nbuf_free(nbuf);
+	return result;
+}
+
+/* Consume a list, taking an independent vdev ref across every callback. */
+static QDF_STATUS
+dp_rx_deliver_passthru_list(struct dp_soc *soc, struct dp_vdev *vdev,
+			   qdf_nbuf_t list)
+{
+	qdf_nbuf_t nbuf, next;
+	QDF_STATUS status = QDF_STATUS_SUCCESS;
+	bool held = !QDF_IS_STATUS_ERROR(dp_vdev_get_ref(soc, vdev,
+						      DP_MOD_ID_RX));
+
+	for (nbuf = list; nbuf; nbuf = next) {
+		next = qdf_nbuf_next(nbuf);
+		qdf_nbuf_set_next(nbuf, NULL);
+		if (!held || QDF_IS_STATUS_ERROR(
+				dp_rx_deliver_raw_passthru(soc, vdev, nbuf))) {
+			dp_rx_nbuf_free(nbuf);
+			status = QDF_STATUS_E_FAILURE;
+		}
+	}
+	if (held)
+		dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_RX);
+	return status;
+}
