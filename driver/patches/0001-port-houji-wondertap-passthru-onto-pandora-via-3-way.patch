+		status = QDF_STATUS_E_INVAL;
+	} else if (pe_find_session_by_vdev_id(mac, msg->vdev_id)) {
+		status = QDF_STATUS_E_BUSY;
+	} else {
+		session = pe_create_session(mac, msg->bss_id.bytes, &session_id,
+				mac->lim.max_sta_of_pe_session, eSIR_PASSTHRU_MODE,
+				msg->vdev_id);
+		status = session ? QDF_STATUS_SUCCESS : QDF_STATUS_E_FAILURE;
+	}
+	if (vdev)
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_MAC_ID);
+	sme_post_passthrough_event(msg->vdev_id, SIR_PASSTHRU_PE_CREATED,
+				   status);
+}
+
+void lim_passthrough_deinit_session(struct mac_context *mac,
+				   struct sir_delete_session *msg)
+{
+	struct pe_session *session;
+	QDF_STATUS status = QDF_STATUS_E_INVAL;
