+/* Validate only the linear 802.11 header and the producer metadata contract.
+ * This is not a validator of action/data payloads or a TX-status mechanism.
+ */
+static bool
+dp_tx_passthru_validate_frame(const uint8_t *frame, uint32_t len,
+			     const struct qdf_wonder_tx_metadata *meta,
+			     uint8_t *tid)
+{
+	uint16_t fc;
+	uint32_t hdrlen;
+	uint8_t type;
+
+	if (!frame || !meta || !tid || len < 2 || len > 0xffff)
+		return false;
+	fc = frame[0] | ((uint16_t)frame[1] << 8);
+	type = fc & 0x0c;
+	if ((fc & 0x0003) || type != meta->frame_type)
+		return false;
+
+	switch (type) {
+	case 0x00: /* Management header, including optional HT control. */
+		hdrlen = 24 + ((fc & 0x8000) ? 4 : 0);
+		break;
+	case 0x08: /* Data: optional Addr4, QoS control and HT control. */
+		hdrlen = 24 + (((fc & 0x0300) == 0x0300) ? 6 : 0);
+		if (fc & 0x0080) {
+			hdrlen += 2;
+			if (fc & 0x8000)
+				hdrlen += 4;
+		}
+		break;
+	case 0x04: /* Legacy control types only; ACK and CTS have no Addr2. */
+		if ((fc & 0x00f0) < 0x0080)
+			return false;
+		hdrlen = ((fc & 0x00e0) == 0x00c0) ? 10 : 16;
+		break;
+	default: /* Extension frame layouts are outside this profile. */
+		return false;
+	}
+	if (len < hdrlen || meta->is_unicast > 1 ||
+	    meta->is_unicast != !(frame[4] & 1))
+		return false;
+
+	/* Retain the fixed donor's TID policy, without native bool decoding. */
+	if (!meta->is_unicast || meta->tid >= 8)
+		*tid = 0;
+	else if (type == 0x00 || type == 0x04)
+		*tid = 6;
+	else
+		*tid = meta->tid;
+	return true;
+}
