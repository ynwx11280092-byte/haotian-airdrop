+#ifdef DRIVER_PASSTHRU_SESSION
+static QDF_STATUS sme_passthru_flush(struct scheduler_msg *msg)
+{
+	if (!msg)
+		return QDF_STATUS_E_INVAL;
+	qdf_mem_free(msg->bodyptr);
+	msg->bodyptr = NULL;
+	return QDF_STATUS_SUCCESS;
+}
+
+QDF_STATUS sme_set_passthrough_mode_cb(mac_handle_t mac_handle,
+	void (*callback)(uint8_t, enum sir_passthru_event, QDF_STATUS, uint32_t))
+{
+	struct mac_context *mac = MAC_CONTEXT(mac_handle);
+	QDF_STATUS status;
+
+	if (!mac)
+		return QDF_STATUS_E_INVAL;
+	status = sme_acquire_global_lock(&mac->sme);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	if (!callback) {
+		mac->sme.passthrough_mode_cb = NULL;
+		mac->sme.passthrough_cb_retired = true;
+	} else if (mac->sme.passthrough_cb_retired) {
+		status = QDF_STATUS_E_INVAL;
+	} else if (mac->sme.passthrough_mode_cb &&
+		   mac->sme.passthrough_mode_cb != callback) {
+		status = QDF_STATUS_E_BUSY;
+	} else {
+		mac->sme.passthrough_mode_cb = callback;
+	}
+	sme_release_global_lock(&mac->sme);
+	return status;
+}
+
+QDF_STATUS sme_post_passthrough_channel_event(uint8_t vdev_id,
+				    enum sir_passthru_event event,
+				    QDF_STATUS result, uint32_t cookie)
+{
+	struct sir_passthru_event_result *body;
+	struct scheduler_msg msg = {0};
+	QDF_STATUS status;
+
+	if (event >= SIR_PASSTHRU_EVENT_MAX)
+		return QDF_STATUS_E_INVAL;
+	body = qdf_mem_malloc(sizeof(*body));
+	if (!body)
+		return QDF_STATUS_E_NOMEM;
+	body->vdev_id = vdev_id;
+	body->cookie = cookie;
+	body->event = event;
+	body->status = result;
+	msg.type = eWNI_SME_PASSTHRU_EVENT;
+	msg.bodyptr = body;
+	msg.flush_callback = sme_passthru_flush;
+	status = scheduler_post_message(QDF_MODULE_ID_SME, QDF_MODULE_ID_SME,
+					QDF_MODULE_ID_SME, &msg);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		sme_passthru_flush(&msg);
+		sme_err("Failed passthrough event %u vdev %u: %u",
+			event, vdev_id, status);
+	}
+	return status;
+}
+
+QDF_STATUS sme_post_passthrough_event(uint8_t vdev_id,
+				    enum sir_passthru_event event,
+				    QDF_STATUS result)
+{
+	return sme_post_passthrough_channel_event(vdev_id, event, result, 0);
+}
+
+/* Called only under sme_process_msg's global lock. Callback must not reenter
+ * SME registration or wait for this queue. Retired queued events are dropped.
+ */
+static QDF_STATUS sme_process_passthrough_event(struct mac_context *mac,
+				struct sir_passthru_event_result *body)
+{
+	if (!body || body->event >= SIR_PASSTHRU_EVENT_MAX)
+		return QDF_STATUS_E_INVAL;
+	if (!mac->sme.passthrough_mode_cb || mac->sme.passthrough_cb_retired)
+		return QDF_STATUS_E_INVAL;
+	mac->sme.passthrough_mode_cb(body->vdev_id, body->event,
+				  body->status, body->cookie);
+	return QDF_STATUS_SUCCESS;
+}
+
+QDF_STATUS sme_create_pe_session(mac_handle_t mac_handle, uint8_t *bssid,
+				uint8_t vdev_id, enum QDF_OPMODE op_mode)
+{
+	struct mac_context *mac = MAC_CONTEXT(mac_handle);
+	struct sir_create_session *body;
+	struct scheduler_msg msg = {0};
+	QDF_STATUS status;
+
+	if (op_mode == QDF_MONITOR_MODE)
+		return sme_create_mon_session(mac_handle, bssid, vdev_id);
+	if (op_mode != QDF_PASSTHRU_MODE || !bssid || !mac)
+		return QDF_STATUS_E_INVAL;
+	body = qdf_mem_malloc(sizeof(*body));
+	if (!body)
+		return QDF_STATUS_E_NOMEM;
+	body->type = eWNI_SME_PASSTHRU_INIT_SESSION;
+	body->vdev_id = vdev_id;
+	body->msg_len = sizeof(*body);
+	qdf_mem_copy(body->bss_id.bytes, bssid, QDF_MAC_ADDR_SIZE);
+	msg.type = body->type;
+	msg.bodyptr = body;
+	msg.flush_callback = sme_passthru_flush;
+	/* The scheduler only enqueues; it does not call PE synchronously. Keep
+	 * admission and post under the registration lock so retire closes entry.
+	 */
+	status = sme_acquire_global_lock(&mac->sme);
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		if (!mac->sme.passthrough_mode_cb || mac->sme.passthrough_cb_retired)
+			status = QDF_STATUS_E_INVAL;
+		else
+			status = scheduler_post_message(QDF_MODULE_ID_SME,
+				QDF_MODULE_ID_PE, QDF_MODULE_ID_PE, &msg);
+		sme_release_global_lock(&mac->sme);
+	}
+	if (QDF_IS_STATUS_ERROR(status))
+		sme_passthru_flush(&msg);
+	return status; /* Queue acceptance only; PE_CREATED reports PE result. */
+}
+
+QDF_STATUS sme_delete_pe_session(mac_handle_t mac_handle, uint8_t vdev_id,
+				enum QDF_OPMODE op_mode)
+{
+	struct sir_delete_session *body;
+	struct scheduler_msg msg = {0};
+	QDF_STATUS status;
+
+	if (op_mode == QDF_MONITOR_MODE)
+		return sme_delete_mon_session(mac_handle, vdev_id);
+	if (op_mode != QDF_PASSTHRU_MODE)
+		return QDF_STATUS_E_INVAL;
+	/* Cleanup remains possible after callback retirement. Queue draining and
+	 * session teardown must precede final context destruction by the owner.
+	 */
+	if (!mac_handle)
+		return QDF_STATUS_E_INVAL;
+	body = qdf_mem_malloc(sizeof(*body));
+	if (!body)
+		return QDF_STATUS_E_NOMEM;
+	body->type = eWNI_SME_PASSTHRU_DEINIT_SESSION;
+	body->vdev_id = vdev_id;
+	body->msg_len = sizeof(*body);
+	msg.type = body->type;
+	msg.bodyptr = body;
+	msg.flush_callback = sme_passthru_flush;
+	status = scheduler_post_message(QDF_MODULE_ID_SME, QDF_MODULE_ID_PE,
+					QDF_MODULE_ID_PE, &msg);
+	if (QDF_IS_STATUS_ERROR(status))
+		sme_passthru_flush(&msg);
+	return status; /* Not an acknowledgement that firmware is stopped. */
+}
