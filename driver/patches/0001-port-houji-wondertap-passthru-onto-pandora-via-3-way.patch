diff --git a/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_iface.h b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_iface.h
new file mode 100644
index 0000000..1b37be2
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_iface.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef _WLAN_HDD_PASSTHRU_IFACE_H_
+#define _WLAN_HDD_PASSTHRU_IFACE_H_
+
+#include "wlan_hdd_passthru_owner.h"
+#include "wlan_hdd_passthru_vdev.h"
+struct hdd_context;
+struct hdd_adapter;
+struct net_device;
+
+/* The runtime coordinator owns this preallocated record and serializes its
+ * methods. Keep it and registry alive through netdev unregister, all provider
+ * leases and driver work/IRQ fences. No pointer to Wonder is retained.
+ */
+struct hdd_pt_iface {
+	struct hdd_context *hdd;
+	struct hdd_adapter *adapter;
+	struct hdd_pt_registry *registry;
+	struct hdd_pt_vdev_record vdev_record;
+	u64 generation;
+	u16 frequency;
+	bool create_attempted;
+	bool vdev_created;
+	bool owner_started;
+	bool owner_reaped;
+	bool policy_registered;
+	bool coexist_prepared;
+	int error;
+};
+
+/* Called by hdd_alloc_station_adapter BEFORE netdev registration. */
+void hdd_pt_set_netdev_ops(struct net_device *dev);
+
+/* Caller holds RTNL and exclusive runtime ownership; slot is zeroed once.
+ * After any returned error, a non-NULL slot->adapter remains owned by slot.
+ * Never discard it or repeat CREATE: a FW-create failure may be ambiguous.
+ * No other thread may close/destroy this adapter via ordinary HDD teardown.
+ * Success means owner CREATE accepted, not FW UP or usable data.
+ * Initial experiment excludes existing connections; this is NOT a complete
+ * concurrency reservation. Runtime publication still needs the policy gate.
+ */
+int hdd_pt_iface_create(struct hdd_pt_iface *slot, struct hdd_context *hdd,
+			struct hdd_pt_registry *registry, u64 generation,
+			const u8 mac[6], const u8 bssid[6], u16 frequency);
+
+/* Non-waiting: can be called by Wonder deinit with RTNL/wt lock/lease held. */
+void hdd_pt_iface_close(struct hdd_pt_iface *slot,
+			const char country[3], unsigned int reason);
+
+void hdd_pt_coexist_release(struct hdd_pt_iface *slot);
+
+/* Worker only, OUTSIDE RTNL and driver transitions, serialized against create
+ * and all slot users. Busy never frees. If Wonder's RX handler is still
+ * attached, retain the physical adapter until consumer quiesce removes it.
+ * Unknown FW creation/deletion remains blocked for explicit SSR cleanup.
+ */
+int hdd_pt_iface_cleanup(struct hdd_pt_iface *slot);
+/* Post-CDS recovery finish only, caller ALREADY holds RTNL and exclusive
+ * runtime control. No wait for owner work/users; no recursive RTNL acquire.
+ * Caller must run rtnl_unlock (unregister tails) before releasing runtime.
+ */
+int hdd_pt_iface_recovery_cleanup(struct hdd_pt_iface *slot);
+#endif
diff --git a/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_owner.h b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_owner.h
new file mode 100644
index 0000000..6928fcf
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_owner.h
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef _WLAN_HDD_PASSTHRU_OWNER_H_
+#define _WLAN_HDD_PASSTHRU_OWNER_H_
+
+#ifdef HOUJI_PT_OWNER_HOST_TEST
+#include "owner_host.h"
+#else
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/types.h>
+#endif
+
+struct wlan_hdd_link_info;
+struct wlan_objmgr_vdev;
+struct hdd_pt_owner;
+struct hdd_pt_vdev_record;
+struct sk_buff;
+
+enum hdd_pt_phase {
+	HDD_PT_CREATING,
+	HDD_PT_BOUND,
+	HDD_PT_ACTIVE,
+	HDD_PT_CLOSING,
+	HDD_PT_BLOCKED,
+	HDD_PT_RECOVERING,
+	HDD_PT_DRAINED,
+};
+
+/* One registry per WLAN runtime, initialized before publication.
+ * Its caller must keep adapter/link, MAC, scheduler, CDP, pdev and module text
+ * alive until retire + reap finish AND the normal driver teardown fences run.
+ * A registry or objmgr reference is not a replacement for those lifetimes.
+ */
+struct hdd_pt_registry {
+	spinlock_t lock;
+	wait_queue_head_t idle;
+	struct hdd_pt_owner *owner;
+	u64 generation;
+	unsigned int users;
+	bool closed;
+	bool reaping;
+};
+
+struct hdd_pt_status {
+	enum hdd_pt_phase phase;
+	int error;
+	int detach_error;
+	bool detach_attempted;
+	bool recovery_prepared;
+	bool recovery_collected;
+};
+
+void hdd_pt_registry_init(struct hdd_pt_registry *registry, u64 generation);
+
+/* Adopt ONE already-created PASSTHRU vdev and its physical HDD netdev.
+ * Process context; initial submission does not wait for PE/DP/worker work.
+ * It may run under RTNL; runtime teardown must be excluded. Caller owns adapter
+ * allocation/registration; this record owns its exclusive vdev-delete right.
+ * Zero means accepted asynchronously, NOT ready. Negative means not adopted.
+ * No second start is allowed until reap, including pending/failed CREATE.
+ * Never pass Wonder's virtual netdev, or an adapter ordinary teardown can
+ * destroy concurrently. MODE/interface construction is deliberately separate.
+ */
+int hdd_pt_start(struct hdd_pt_registry *registry,
+		 struct wlan_hdd_link_info *link, u16 frequency,
+		 const u8 bssid[6]);
+/* Journal stays alive until owner reap; normal unjournaled API is retained
+ * for existing standalone owner users. MODE always uses this tracked entry.
+ */
+int hdd_pt_start_record(struct hdd_pt_registry *registry,
+                        struct wlan_hdd_link_info *link, u16 frequency,
+                        const u8 bssid[6], struct hdd_pt_vdev_record *record);
+
+/* Recovery PREPARATION only, outside RTNL/transitions/component locks.
+ * Sticky: closes admission, joins the ordinary worker, stops endpoint calls,
+ * and releases only this owner's objmgr reference after control/TX/RX tickets
+ * drain. BUSY retains that reference and can be retried. Pending requests,
+ * PE, DP installation and physical netdev remain owned, including on success.
+ * Does not send DELETE, reset hardware, purge PE, join DP or permit parent
+ * destruction. No resume in the same epoch. The post-fence recovery route is
+ * still required before production publication.
+ */
+int hdd_pt_recovery_freeze(struct hdd_pt_registry *registry, u64 generation);
+
+/* After successful freeze AND this epoch's scheduler/WMI/RX fences
+ * and PE purge; all parent contexts remain alive and teardown is serialized.
+ * Collect completed request references only with another proven pin, then join
+ * the stopped DP endpoint. Never submits/repeats vdev DELETE. Must precede
+ * the global DP receipt check. Success retains RECOVERING, gate/dev_hold and
+ * registry; it does NOT permit physical iface or parent destruction.
+ */
+int hdd_pt_recovery_collect(struct hdd_pt_registry *registry, u64 generation);
+
+int hdd_pt_status(struct hdd_pt_registry *registry, u64 generation,
+		  struct hdd_pt_status *status);
+
+/* BOUND only proves local PE + DP binding. The control owner calls activate
+ * only AFTER actual channel/start/up completion and all setup commits.
+ */
+/* Synchronous control operation, worker context only. A gate ticket
+ * pins the adopted vdev/endpoint against owner deletion for the entire
+ * callback. The control mutex is NOT held across the callback, which
+ * may query status or activate. Close stays nonblocking; teardown waits
+ * for this ticket. Operation must not reap/retire/wait on this owner.
+ */
+int hdd_pt_with_bound(struct hdd_pt_registry *registry, u64 generation,
+		       int (*operation)(void *context), void *context);
+
+/* Synchronous active-session channel transaction. Runtime serializes calls;
+ * caller pins parents with DSC and supplies an independently armed deadline.
+ * Pause closes CPU admission; it does not drain firmware/DMA queues.
+ * operation must return actual matched FW completion, never queue acceptance.
+ * Any failure after pause closes this owner. No RTNL/work/transition wait.
+ */
+int hdd_pt_with_channel(struct hdd_pt_registry *registry, u64 generation,
+                       u16 frequency, unsigned long deadline,
+                       int (*operation)(void *context), void *context);
+
+/* Synchronous active-session control operation pinned by a gate ticket
+ * against owner close/vdev teardown. Neither RTNL nor owner->control mutex
+ * is held across operation().
+ */
+int hdd_pt_with_active(struct hdd_pt_registry *registry, u64 generation,
+		       int (*operation)(struct wlan_objmgr_vdev *vdev,
+					u64 generation, void *context),
+		       void *context);
+
+int hdd_pt_activate(struct hdd_pt_registry *registry, u64 generation);
+
+/* Non-sleeping readiness query for netdev ndo_open; no control mutex. */
+bool hdd_pt_data_ready(struct hdd_pt_registry *registry, u64 generation);
+
+/* Always consumes the entire skb list, also on stale/closed/error paths. */
+void hdd_pt_tx(struct hdd_pt_registry *registry, u64 generation,
+	       struct sk_buff *head);
+
+/* Non-waiting, preallocated handoff, usable from Wonder void deinit.
+ * Wonder must first close TX and synchronously unregister its RX handler.
+ */
+int hdd_pt_close(struct hdd_pt_registry *registry, u64 generation,
+		  const char country[3], unsigned int reason);
+
+/* Close registry admission before CNSS lease wait / transition acquisition.
+ * This does not stop scheduler/RX, purge SSR state, or claim firmware is dead.
+ */
+int hdd_pt_retire(struct hdd_pt_registry *registry, unsigned int reason);
+
+/* Process context, outside RTNL/transitions. Returns BUSY until actual endpoint
+ * stop -> PE delete -> hdd_vdev_destroy -> DP join completed. Unknown/error
+ * outcomes retain ownership; never retry real vdev delete or force success.
+ * On success extra dev_hold is already released and worker/public tails joined.
+ * Caller must then unregister/free the physical adapter and run normal runtime
+ * fences. Registry storage cannot be freed while external entrypoints exist.
+ * SSR host-only recovery is not implemented here: BLOCKED prevents deployment
+ * until that route and the outer HDD hooks are wired.
+ */
+int hdd_pt_reap(struct hdd_pt_registry *registry);
+/* After completed freeze, current CDS PE/DP/WMI/RX fences and WMA reap.
+ * Nonwaiting recovery reap: requires no public users, joined work, no handles,
+ * and a completed ordinary vdev-delete journal (or already DRAINED owner).
+ * Timeout/ambiguous delete remains blocked. Does not retry DELETE or imply
+ * that all objmgr component destructors have completed. Caller still owns
+ * physical netdev/parent lifetimes and must run ordinary teardown barriers.
+ */
+int hdd_pt_recovery_reap(struct hdd_pt_registry *registry, u64 generation);
+#endif
diff --git a/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_runtime.h b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_runtime.h
new file mode 100644
index 0000000..9f2f4ad
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_runtime.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef _WLAN_HDD_PASSTHRU_RUNTIME_H_
+#define _WLAN_HDD_PASSTHRU_RUNTIME_H_
+
+#include "cnss_wonder_lifecycle.h"
+struct hdd_context;
+
+/*
+ * Experimental coordinator; NOT called by ordinary HDD lifecycle yet.
+ * Register only with a live SME/DP runtime and an exclusive PASSTHRU policy
+ * reservation. Parent lifetime is the caller's responsibility.
+ *
+ * Both functions run outside RTNL, DSC transitions and component locks.
+ * Retire must precede every parent teardown, including idle stop and SSR.
+ * Any retire error means parents MUST remain alive: no force-free fallback.
+ * A BLOCKED/pre-owner orphan still requires a separate SSR recovery route.
+ * Do not enable publication in HDD until that route and all hooks exist.
+ *
+ * One interface per SME epoch: events lack generation tags. After unregister,
+ * SME deliberately refuses callback rearming until a fresh SME open.
+ */
+/* Experimental activation after successful module init (MODULE_STATE_LIVE).
+ * First admitted attempt permanently pins this module until full reboot,
+ * even if later publication fails. Normal rmmod is intentionally unavailable
+ * afterwards; retire/SSR success does not drop the pin. Built-in code needs
+ * no pin. This does not protect device unbind, forced removal or soft-unload.
+ */
+int hdd_pt_runtime_register(struct hdd_context *hdd);
+int hdd_pt_runtime_retire(struct hdd_context *hdd,
+			 enum cnss_wonder_retire_reason reason);
+/* Recovery preparation; same lock/context restrictions as retire.
+ * Retires CNSS leases, unregisters SME callback, freezes runtime/owner work.
+ * Zero only means preparation, NOT permission to destroy parents.
+ * Pre-owner ambiguous creation returns EUCLEAN with storage retained.
+ * A complete post-fence PE/WMA/DP collection path is still required.
+ */
+/* Also permanently seals registration for this module instance, including
+ * when no runtime exists. A rejected mismatched context does not seal it.
+ */
+int hdd_pt_runtime_recovery_freeze(struct hdd_context *hdd,
+                                 enum cnss_wonder_retire_reason reason);
+/* CDS stop preflight: absent runtime or completed recovery preparation only.
+ * Try-locks avoid inverse waits while the caller holds a DSC transition.
+ * Caller excludes registration for the whole stop epoch.
+ */
+int hdd_pt_runtime_recovery_check(struct hdd_context *hdd);
+/* After scheduler/WMI/RX fences and successful PE purge, before DP receipts.
+ * Collect/join only; no RTNL, provider waits, iface free or phase promotion.
+ */
+int hdd_pt_runtime_recovery_collect(struct hdd_context *hdd);
+/* Final parent-lifetime guard: only a fully retired/absent runtime succeeds.
+ * collect success alone must not allow CDS to destroy its parent contexts.
+ */
+int hdd_pt_runtime_teardown_check(struct hdd_context *hdd);
+/* After this CDS epoch's PE purge, global DP receipts and WMA reap.
+ * Trylocks only for lifecycle/control/RTNL. Finishes the narrow proven-delete
+ * path; unknown outcomes retain runtime. Normal parent barriers still apply.
+ */
+int hdd_pt_runtime_recovery_finish(struct hdd_context *hdd);
+#endif
diff --git a/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_vdev.h b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_vdev.h
new file mode 100644
index 0000000..732655e
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wlan_hdd_passthru_vdev.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef _WLAN_HDD_PASSTHRU_VDEV_H_
+#define _WLAN_HDD_PASSTHRU_VDEV_H_
+
+#include <linux/types.h>
+
+struct wlan_hdd_link_info;
+struct hdd_pt_vdev_record;
+
+#ifdef DRIVER_PASSTHRU_OWNER
+enum hdd_pt_vdev_step {
+	HDD_PT_VDEV_CREATE_CALLED = 1U << 0,
+	HDD_PT_VDEV_OBTAINED = 1U << 1,
+	HDD_PT_VDEV_HDD_REF_ACQUIRED = 1U << 2,
+	HDD_PT_VDEV_CREATE_RETURNED = 1U << 3,
+	HDD_PT_VDEV_DELETE_CALLED = 1U << 4,
+	HDD_PT_VDEV_HDD_REF_RELEASED = 1U << 5,
+	HDD_PT_VDEV_SME_DELETE_CALLED = 1U << 6,
+	HDD_PT_VDEV_DELETE_WAIT_STARTED = 1U << 7,
+	HDD_PT_VDEV_DELETE_WAIT_COMPLETED = 1U << 8,
+	HDD_PT_VDEV_DELETE_WAIT_TIMED_OUT = 1U << 9,
+	HDD_PT_VDEV_DELETE_RETURNED = 1U << 10,
+	HDD_PT_VDEV_SME_CREATE_CALLED = 1U << 11,
+};
+
+/* One zeroed record per physical iface; set generation before first create.
+ * The caller serializes create/destroy/readers and keeps the record, adapter
+ * and link alive. With DRIVER_PASSTHRU_MODE, generation must equal
+ * adapter->passthru_generation; otherwise the caller owns generation binding.
+ * link is an identity token, not an owned reference. No vdev pointer is saved.
+ *
+ * *_result holds the actual HDD return value once its RETURNED bit is set.
+ * sme_delete_status is the raw QDF_STATUS, valid after DELETE_RETURNED if
+ * SME_DELETE_CALLED is set. A successful SME call means submission only.
+ * WAIT_COMPLETED only records the existing completion wait, not a DP join
+ * or proof of hardware/FW deletion. Timeout is never promoted to completion.
+ * Missing OBTAINED means HDD received no object; it does not certify that
+ * lower-layer creation rollback finished after SME_CREATE_CALLED.
+ * This journal does not authorize SSR cleanup or claim resources are gone.
+ */
+struct hdd_pt_vdev_record {
+	u64 generation;
+	const struct wlan_hdd_link_info *link;
+	u32 steps;
+	u8 vdev_id;
+	int create_result;
+	int delete_result;
+	int sme_delete_status;
+};
+
+int hdd_pt_vdev_create(struct wlan_hdd_link_info *link,
+		       struct hdd_pt_vdev_record *record);
+int hdd_pt_vdev_destroy(struct wlan_hdd_link_info *link,
+			struct hdd_pt_vdev_record *record);
+
+/* Serialized snapshot only; caller still owns all lifetime/admission gates. */
+static inline bool
+hdd_pt_vdev_adoptable(const struct hdd_pt_vdev_record *record,
+		      const struct wlan_hdd_link_info *link, u64 generation)
+{
+	const u32 required = HDD_PT_VDEV_CREATE_CALLED |
+		HDD_PT_VDEV_SME_CREATE_CALLED |
+		HDD_PT_VDEV_OBTAINED | HDD_PT_VDEV_HDD_REF_ACQUIRED |
+		HDD_PT_VDEV_CREATE_RETURNED;
+
+	return record && link && generation && record->link == link &&
+		record->generation == generation &&
+		(record->steps & required) == required &&
+		!record->create_result &&
+		!(record->steps & (HDD_PT_VDEV_DELETE_CALLED |
+				  HDD_PT_VDEV_HDD_REF_RELEASED |
+				  HDD_PT_VDEV_SME_DELETE_CALLED));
+}
+#endif
+#endif
diff --git a/qcacld-3.0/core/hdd/inc/wlan_hdd_wonder_handoff.h b/qcacld-3.0/core/hdd/inc/wlan_hdd_wonder_handoff.h
new file mode 100644
index 0000000..87a9e55
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wlan_hdd_wonder_handoff.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef _WLAN_HDD_WONDER_HANDOFF_H_
+#define _WLAN_HDD_WONDER_HANDOFF_H_
+#ifdef HOUJI_HANDOFF_HOST_TEST
+#include "tests/host_kernel.h"
+#else
+#include <linux/types.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/netdevice.h>
+#endif
+
+enum hdd_wh_state { HDD_WH_OPEN, HDD_WH_CLOSING, HDD_WH_DRAINED, HDD_WH_RELEASED };
+/* Preallocated, single-runtime record. No Wonder object or callback pointer.
+ * Registry ownership pins this record across EVERY helper/actor invocation.
+ * Process/softirq contexts only: spin_lock_bh is not a hardirq/NMI contract.
+ * sink is an HDD physical netdev, never Wonder's virtual netdev. dev_hold
+ * does NOT pin Wonder, CDP, IRQ, DMA, module code, or queued packet tails.
+ */
+struct hdd_wh_gate {
+	spinlock_t lock;
+	wait_queue_head_t changed;
+	struct net_device *sink;
+	u64 generation;
+	u64 next_cookie;
+	u64 current_cookie;
+	unsigned int users;
+	unsigned int reasons;
+	enum hdd_wh_state state;
+	bool actor;
+	char country[3];
+};
+struct hdd_wh_ticket { struct hdd_wh_gate *gate; u64 generation; };
+struct hdd_wh_claim { struct hdd_wh_gate *gate; u64 generation; u64 cookie; };
+
+/* Single-threaded, before registry publication; never reinitialize a record. */
+int hdd_wh_init(struct hdd_wh_gate *g, struct net_device *physical_sink, u64 generation);
+/* All control operations and RX forwarding require a non-copied ticket.
+ * Caller keeps the registry record pinned until leave returns. No callback
+ * is executed by these helpers, and no waiting for other users occurs.
+ */
+int hdd_wh_enter(struct hdd_wh_gate *g, u64 generation, struct hdd_wh_ticket *ticket);
+int hdd_wh_leave(struct hdd_wh_ticket *ticket);
+/* Valid same-generation close is allocation-free, idempotent and non-waiting.
+ * First close copies country; later closes only OR their retirement reasons.
+ * Wonder RX handler MUST already have been synchronously unregistered by
+ * the existing .stop/rollback path before its backend deinit calls close.
+ */
+int hdd_wh_close(struct hdd_wh_gate *g, u64 generation, const char country[3], unsigned int reason);
+bool hdd_wh_work_pending(struct hdd_wh_gate *g);
+/* Worker/retire actor runs outside RTNL/wt-lock/CNSS lease and incompatible
+ * runtime transitions. Exactly one claimant, only after all tickets leave.
+ */
+int hdd_wh_try_claim(struct hdd_wh_gate *g, u64 generation, struct hdd_wh_claim *claim);
+/* done=true requires ACTUAL endpoint stop -> actual vdev detach -> join and
+ * callback/producer drain while the parent objects still exist. This helper
+ * supplies none of these. It does NOT require final netdev unregistration:
+ * that comes AFTER release of this gate's extra dev_hold (see below).
+ * done=false retains CLOSING and all ownership, allowing a future retry.
+ */
+int hdd_wh_finish(struct hdd_wh_claim *claim, bool done);
+/* Only after registry unpublication, all helper/caller/actor tails returned,
+ * and actual backend/producer drain. The outer HDD owner must still own the
+ * registered physical netdev and its allocation independently of this gate.
+ * Release this extra dev_hold BEFORE synchronous unregister_netdev or the
+ * rtnl_unlock that runs a queued unregister: netdev_wait_allrefs_any waits
+ * for refcount == 1, so unregister-then-release can deadlock on our reference.
+ * The outer owner subsequently performs unregister and required network /
+ * parent teardown barriers. Only after those and all owner execution tails
+ * end may it free the record. This helper neither unregisters nor frees it.
+ * DRAINED is not proof of these external ownership/lifetime preconditions.
+ */
+int hdd_wh_release(struct hdd_wh_gate *g);
+#endif
diff --git a/qcacld-3.0/core/hdd/inc/wonder/wondertap.h b/qcacld-3.0/core/hdd/inc/wonder/wondertap.h
new file mode 100644
index 0000000..6096382
--- /dev/null
+++ b/qcacld-3.0/core/hdd/inc/wonder/wondertap.h
@@ -0,0 +1,524 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Public API for the WonderTap Operations.
+ *
+ * This header file defines the complete API contract that a vendor-specific
+ * driver must implement to integrate with the generic WonderTap operations.
+ * It includes the core operations structure (wondertap_ops), all related
+ * data structures, and the public functions for registration and control.
+ */
+#ifndef __WONDER_WONDERTAP_H__
+#define __WONDER_WONDERTAP_H__
+
+#include <linux/errno.h>
+#include <linux/if_ether.h>
+
+#define WONDERTAP_VHT_NSS_MAX   8
+#define WONDERTAP_HE_NSS_MAX    8
+#define WONDERTAP_EHT_NSS_MAX   8
+#define WONDERTAP_HT_NSS_MAX    4
+
+/** @brief Defines the PHY preamble/protocol for the TX rate. */
+enum wondertap_rate_preamble {
+	WONDERTAP_RATE_PREAMBLE_LEGACY = 0, /* 802.11a/g rates (non-HT) */
+	WONDERTAP_RATE_PREAMBLE_HT = 1, /* 802.11n High Throughput */
+	WONDERTAP_RATE_PREAMBLE_VHT = 2, /* 802.11ac Very High Throughput */
+	WONDERTAP_RATE_PREAMBLE_HE  = 3, /* 802.11ax High Efficiency */
+	WONDERTAP_RATE_PREAMBLE_EHT = 4, /* 802.11be Extremely High Throughput */
+};
+
+/**
+ * @brief Defines which TX rate masks are active in a `wondertap_tx_rate_mask`
+ * configuration.
+ */
+enum wondertap_tx_rate_mask_enable {
+	/**
+	 * @brief If set, the legacy_rates bitmap is valid and should be applied.
+	 */
+	WONDERTAP_RATEMASK_EN_LEGACY = BIT(WONDERTAP_RATE_PREAMBLE_LEGACY),
+
+	/**
+	 * @brief If set, the ht_mcs bitmap is valid and should be applied.
+	 */
+	WONDERTAP_RATEMASK_EN_HT     = BIT(WONDERTAP_RATE_PREAMBLE_HT),
+
+	/**
+	 * @brief If set, the vht_mcs bitmap is valid and should be applied.
+	 */
+	WONDERTAP_RATEMASK_EN_VHT    = BIT(WONDERTAP_RATE_PREAMBLE_VHT),
+
+	/**
+	 * @brief If set, the he_mcs bitmap is valid and should be applied.
+	 */
+	WONDERTAP_RATEMASK_EN_HE     = BIT(WONDERTAP_RATE_PREAMBLE_HE),
+
+	/**
+	 * @brief If set, the eht_mcs bitmap is valid and should be applied.
+	 */
+	WONDERTAP_RATEMASK_EN_EHT    = BIT(WONDERTAP_RATE_PREAMBLE_EHT),
+};
+
+/** @brief Defines the channel bandwidth. */
+enum wondertap_rate_bw {
+	WONDERTAP_RATE_BW_20 = 0,
+	WONDERTAP_RATE_BW_40 = 1,
+	WONDERTAP_RATE_BW_80 = 2,
+	WONDERTAP_RATE_BW_160 = 3,
+	WONDERTAP_RATE_BW_320 = 4,
+};
+
+/** @brief Defines the Guard Interval (GI). */
+enum wondertap_rate_gi {
+	WONDERTAP_RATE_GI_DEFAULT = 0, /* Driver uses default (e.g., Long GI or 0.8us) */
+	WONDERTAP_RATE_GI_SHORT   = 1, /* Short GI for HT/VHT */
+	WONDERTAP_RATE_GI_0_8_US  = 2, /* Specific HE GI values */
+	WONDERTAP_RATE_GI_1_6_US  = 3,
+	WONDERTAP_RATE_GI_3_2_US  = 4,
+};
+
+/** @brief Channel and bandwidth configuration. */
+struct wondertap_set_freq_params {
+	u32 freq;
+	enum wondertap_rate_bw bandwidth;
+};
+
+/**
+ * @brief Enumeration for the different types of hardware filters supported.
+ *
+ * This enum is used in the `wondertap_set_filter` function to specify which
+ * filter is being configured.
+ */
+enum wondertap_filter_type {
+	/**
+	 * @brief Configures a filter based on the 802.11 frame's type and subtype.
+	 */
+	WONDERTAP_FILTER_TYPE_FRAME,
+};
+
+/**
+ * @brief Parameters for configuring the BSSID filter.
+ */
+struct wondertap_bssid_filter_params {
+	/**
+	 * @brief Set to 'true' to enable the filter, 'false' to disable it.
+	 */
+	bool enabled;
+
+	/**
+	 * @brief The BSSID to filter on when the filter is enabled.
+	 * This field is ignored if 'enabled' is false.
+	 */
+	u8 bssid[ETH_ALEN];
+};
+
+/**
+ * @brief Parameters for configuring the frame type/subtype filter.
+ */
+struct wondertap_frame_filter_params {
+	/**
+	 * @brief Set to 'true' to enable the filter, 'false' to disable it.
+	 */
+	bool enabled;
+
+	/**
+	 * @brief The 802.11 frame type to match.
+	 * This field is ignored if 'enabled' is false.
+	 *
+	 * The frame type defines the major category of the frame.
+	 * Use standard Linux kernel definitions from <linux/ieee80211.h>:
+	 * - IEEE80211_FTYPE_MGMT (0x0000): Management frames
+	 * - IEEE80211_FTYPE_CTRL (0x0004): Control frames
+	 * - IEEE80211_FTYPE_DATA (0x0008): Data frames
+	 */
+	u16 frame_type;
+
+	/**
+	 * @brief The 802.11 frame subtype to match.
+	 * This field is ignored if 'enabled' is false.
+	 *
+	 * The subtype specifies the frame's exact purpose within its category.
+	 * Use standard Linux kernel definitions from <linux/ieee80211.h>:
+	 * - e.g., IEEE80211_STYPE_BEACON  (0x0080)
+	 * - e.g., IEEE80211_STYPE_PROBE_REQ (0x0040)
+	 * - e.g., IEEE80211_STYPE_QOS_DATA  (0x0080)
+	 */
+	u16 frame_subtype;
+};
+
+/**
+ * @brief Configures the regulatory domain for the Wi-Fi hardware.
+ *
+ * @param handle The opaque driver instance handle.
+ * @param country_code A two-character null-terminated string representing
+ * the country code in ISO 3166-1 alpha-2 format (e.g., "US",
+ * "GB", "JP", "TW").
+ *
+ * @return: 0 on success, or a negative errno code on failure.
+ */
+
+/**
+ * @brief Parameters to configure a specific TX rate.
+ *
+ * This structure is used to define a complete transmission rate,
+ * including its PHY characteristics and special features.
+ */
+struct wondertap_fixed_tx_rate_params {
+	/**
+	 * @brief The preamble/PHY type for this rate.
+	 */
+	enum wondertap_rate_preamble preamble;
+
+	/**
+	 * @brief The channel bandwidth for this rate.
+	 */
+	enum wondertap_rate_bw bw;
+
+	/**
+	 * @brief The Guard Interval (GI) for this rate.
+	 */
+	enum wondertap_rate_gi gi;
+
+	/**
+	 * @brief The number of spatial streams (NSS).
+	 * Typically 1-4 for client devices. 0 is invalid.
+	 */
+	u8 nss;
+
+	/**
+	 * @brief The Modulation and Coding Scheme (MCS) index.
+	 * - For HT (802.11n): 0-7 (up to 31 for 4 streams).
+	 * - For VHT (802.11ac): 0-9.
+	 * - For HE (802.11ax): 0-11.
+	 * - For Legacy: This field is interpreted as the legacy rate index
+	 * (e.g., index for 54 Mbps, 48 Mbps, etc.). Ignored by some drivers.
+	 */
+	u8 mcs;
+
+	/** @brief Reserved for future use. */
+	u8 reserved[2];
+};
+
+/**
+ * @brief Per-packet transmission descriptor.
+ *
+ * This structure is intended to be stored in the `sk_buff->cb` control buffer
+ * to provide per-packet transmission instructions to the underlying driver.
+ */
+struct wonder_txd {
+	/** @brief True if the frame is a unicast transmission. */
+	bool is_unicast;
+	/** @brief The 802.11 frame type (e.g., IEEE80211_FTYPE_DATA). */
+	u8 frame_type;
+	/** @brief The Traffic Identifier (TID) for QoS. */
+	u8 tid;
+	/** @brief Reserved for future use. */
+	u8 reserved[1];
+};
+// limit the wonder_txd size
+static_assert(sizeof(struct wonder_txd) <= 48);
+
+/**
+ * @brief A unified structure to define the permitted transmission rates for
+ * the rate control algorithm.
+ */
+struct wondertap_tx_rate_mask_params {
+	/**
+	 * @brief A bitmask from `enum wondertap_tx_rate_mask_enable` that
+	 * specifies which of the rate masks in this structure are valid and
+	 * should be applied by the driver.
+	 */
+	u32 enable_mask;
+
+	/**
+	 * @brief A bitmap of permitted legacy (802.11a/g) rates.
+	 * The bits correspond to the driver's internal legacy rate indices.
+	 * This field is only valid if WONDERTAP_RATEMASK_EN_LEGACY is set.
+	 */
+	u32 legacy_rates;
+
+	/**
+	 * @brief A bitmap of permitted HT (802.11n) MCS values for each
+	 * number of spatial streams (NSS).
+	 *
+	 * The array is indexed by (NSS - 1). For example, `ht_mcs[0]` is the
+	 * MCS mask for 1 spatial stream (NSS=1).
+	 * A bit `(1 << X)` being set in `ht_mcs[Y]` means that MCS index X
+	 * is permitted for (Y+1) spatial streams.
+	 *
+	 * This field is only valid if WONDERTAP_RATEMASK_EN_HT is set.
+	 */
+	u16 ht_mcs[WONDERTAP_HT_NSS_MAX];
+
+	/**
+	 * @brief A bitmap of permitted VHT (802.11ac) MCS values for each NSS.
+	 *
+	 * The array is indexed by (NSS - 1). For example, `vht_mcs[0]` is the
+	 * MCS mask for 1 spatial stream.
+	 * A bit `(1 << X)` being set in `vht_mcs[Y]` means that MCS index X
+	 * (0-9) is permitted for (Y+1) spatial streams.
+	 *
+	 * This field is only valid if WONDERTAP_RATEMASK_EN_VHT is set.
+	 */
+	u16 vht_mcs[WONDERTAP_VHT_NSS_MAX];
+
+	/**
+	 * @brief A bitmap of permitted HE (802.11ax) MCS values for each NSS.
+	 *
+	 * The array is indexed by (NSS - 1). For example, `he_mcs[0]` is the
+	 * MCS mask for 1 spatial stream.
+	 * A bit `(1 << X)` being set in `he_mcs[Y]` means that MCS index X
+	 * (0-11) is permitted for (Y+1) spatial streams.
+	 *
+	 * This field is only valid if WONDERTAP_RATEMASK_EN_HE is set.
+	 */
+	u16 he_mcs[WONDERTAP_HE_NSS_MAX];
+
+	/**
+	 * @brief A bitmap of permitted EHT (802.11be) MCS values for each NSS.
+	 *
+	 * The array is indexed by (NSS - 1). For example, `eht_mcs[0]` is the
+	 * MCS mask for 1 spatial stream.
+	 * A bit `(1 << X)` being set in `eht_mcs[Y]` means that MCS index X
+	 * (0-13) is permitted for (Y+1) spatial streams.
+	 *
+	 * This field is only valid if WONDERTAP_RATEMASK_EN_EHT is set.
+	 */
+	u16 eht_mcs[WONDERTAP_EHT_NSS_MAX];
+};
+
+
+/** @brief Supported hardware/software features. Used for get_capabilities. */
+/** @brief Supported hardware/software features. */
+struct wondertap_capability {
+    /** @brief Capability structure version.
+      * @note For the initial implementation, this must be set to 0.
+      */
+    u32 version;
+    union {
+        /* @brief All capability flags as a single 32-bit word. */
+        u32 raw_bits;
+        /* @brief Access to individual capability bits. */
+        struct {
+            /* @brief Dynamic rate adaptation is supported. */
+            u32 rate_adaptation: 1;
+            /* @brief STA (Station) coexistence is supported. */
+            u32 sta_coexist: 1;
+            /* @brief SAP (Soft AP) coexistence is supported. */
+            u32 sap_coexist: 1;
+            /* @brief P2P (Wi-Fi Direct) coexistence is supported. */
