+/* Independent control-layer completion contract; no HDD/provider is published. */
+#ifdef DRIVER_PASSTHRU_OWNER
+/* BEGIN PASSTHRU OWNED REQUEST IMPLEMENTATION */
+enum sme_passthru_request_phase {
+	SME_PASSTHRU_QUEUED,
+	SME_PASSTHRU_RUNNING,
+	SME_PASSTHRU_DONE,
+};
+
+struct sme_passthru_request {
+	qdf_atomic_t refs;
+	qdf_spinlock_t lock;
+	qdf_event_t completion;
+	enum sme_passthru_request_phase phase;
+	bool cancel_requested;
+	/* Non-NULL only after admission accounted the reserved queue ref. */
+	struct mac_context *queue_mac;
+	struct sme_passthru_request_input input;
+	struct sme_passthru_request_result result;
+};
+
+QDF_STATUS sme_passthru_requests_close(mac_handle_t mac_handle)
+{
+	struct mac_context *mac = MAC_CONTEXT(mac_handle);
+	QDF_STATUS status;
+
+	if (!mac)
+		return QDF_STATUS_E_INVAL;
+	status = sme_acquire_global_lock(&mac->sme);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	mac->sme.passthru_requests_closed = true;
+	sme_release_global_lock(&mac->sme);
+	return QDF_STATUS_SUCCESS;
+}
+
+QDF_STATUS sme_passthru_requests_drain_status(mac_handle_t mac_handle,
+		uint32_t *outstanding)
+{
+	struct mac_context *mac = MAC_CONTEXT(mac_handle);
+	QDF_STATUS status;
+	int count;
+
+	if (!mac || !outstanding)
+		return QDF_STATUS_E_INVAL;
+	status = sme_acquire_global_lock(&mac->sme);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	if (!mac->sme.passthru_requests_closed) {
+		status = QDF_STATUS_E_AGAIN;
+	} else {
+		count = qdf_atomic_read(&mac->sme.passthru_queue_refs);
+		/* Pair with the final full-barrier dec_and_test in dispose. */
+		qdf_mb();
+		*outstanding = count;
+		status = count ? QDF_STATUS_E_BUSY : QDF_STATUS_SUCCESS;
+	}
+	sme_release_global_lock(&mac->sme);
+	return status;
+}
+
+bool sme_passthru_request_get(struct sme_passthru_request *request)
+{
+	return request && qdf_atomic_inc_not_zero(&request->refs);
+}
+
+void sme_passthru_request_put(struct sme_passthru_request *request)
+{
+	if (!request || !qdf_atomic_dec_and_test(&request->refs))
+		return;
+	wlan_objmgr_vdev_release_ref(request->input.vdev, WLAN_LEGACY_MAC_ID);
+	qdf_event_destroy(&request->completion);
+	qdf_spinlock_destroy(&request->lock);
+	qdf_mem_free(request);
+}
+
+const struct sme_passthru_request_input *
+sme_passthru_request_input(struct sme_passthru_request *request)
+{
+	return &request->input;
+}
+
+void sme_passthru_request_finish(struct sme_passthru_request *request,
+		QDF_STATUS status, enum sme_passthru_session_state state,
+		bool changed)
+{
+	bool notify = false;
+
+	qdf_spin_lock_bh(&request->lock);
+	if (request->phase != SME_PASSTHRU_DONE) {
+		request->result.status = status;
+		request->result.session_state = state;
+		request->result.changed = changed;
+		request->result.cancel_requested = request->cancel_requested;
+		request->phase = SME_PASSTHRU_DONE;
+		notify = true;
+	}
+	qdf_spin_unlock_bh(&request->lock);
+	/* Caller (normally queue executor/disposer) retains its ref through wake. */
+	if (notify)
+		qdf_event_set_all(&request->completion);
+}
+
+bool sme_passthru_request_begin(struct sme_passthru_request *request)
+{
+	bool begin = false, canceled = false;
+
+	qdf_spin_lock_bh(&request->lock);
+	if (request->phase == SME_PASSTHRU_QUEUED) {
+		if (request->cancel_requested)
+			canceled = true;
+		else {
+			request->phase = SME_PASSTHRU_RUNNING;
+			begin = true;
+		}
+	}
+	qdf_spin_unlock_bh(&request->lock);
+	if (canceled)
+		sme_passthru_request_finish(request, QDF_STATUS_E_CANCELED,
+				SME_PASSTHRU_SESSION_UNKNOWN, false);
+	return begin;
+}
+
+QDF_STATUS sme_passthru_request_cancel(struct sme_passthru_request *request)
+{
+	QDF_STATUS status;
+
+	if (!request)
+		return QDF_STATUS_E_INVAL;
+	qdf_spin_lock_bh(&request->lock);
+	if (request->phase == SME_PASSTHRU_DONE) {
+		status = QDF_STATUS_E_ALREADY;
+	} else {
+		request->cancel_requested = true;
+		status = request->phase == SME_PASSTHRU_QUEUED ?
+			QDF_STATUS_SUCCESS : QDF_STATUS_E_BUSY;
+	}
+	qdf_spin_unlock_bh(&request->lock);
+	return status;
+}
+
+QDF_STATUS sme_passthru_request_query(struct sme_passthru_request *request,
+		struct sme_passthru_request_result *result)
+{
+	QDF_STATUS status = QDF_STATUS_E_PENDING;
+
+	if (!request || !result)
+		return QDF_STATUS_E_INVAL;
+	qdf_spin_lock_bh(&request->lock);
+	if (request->phase == SME_PASSTHRU_DONE) {
+		*result = request->result;
+		status = QDF_STATUS_SUCCESS;
+	}
+	qdf_spin_unlock_bh(&request->lock);
+	return status;
+}
+
+QDF_STATUS sme_passthru_request_wait(struct sme_passthru_request *request,
+		uint32_t timeout_ms, struct sme_passthru_request_result *result)
+{
+	QDF_STATUS status, query;
+
+	if (!request || !result || !timeout_ms)
+		return QDF_STATUS_E_INVAL;
+	status = sme_passthru_request_query(request, result);
+	if (status != QDF_STATUS_E_PENDING)
+		return status;
+	status = qdf_wait_single_event(&request->completion, timeout_ms);
+	query = sme_passthru_request_query(request, result);
+	/* A forced/spurious event is not a completed request. */
+	return query == QDF_STATUS_SUCCESS ? query :
+		(QDF_IS_STATUS_ERROR(status) ? status : query);
+}
+
+bool sme_passthru_request_dispose_msg(struct scheduler_msg *msg,
+		QDF_STATUS status)
+{
+	struct sme_passthru_request *request;
+	struct mac_context *queue_mac;
+
+	if (!msg || (msg->type != eWNI_SME_PASSTHRU_CREATE_REQUEST &&
+		     msg->type != eWNI_SME_PASSTHRU_DELETE_REQUEST))
+		return false;
+	request = msg->bodyptr;
+	msg->bodyptr = NULL;
+	msg->bodyval = 0;
+	if (request) {
+		queue_mac = request->queue_mac;
+		sme_passthru_request_finish(request, status,
+				SME_PASSTHRU_SESSION_UNKNOWN, false);
+		sme_passthru_request_put(request);
+		/* Last MAC access: finish/wake and queue-put tails are over. */
+		if (queue_mac)
+			qdf_atomic_dec_and_test(&queue_mac->sme.passthru_queue_refs);
+	}
+	return true;
+}
+
+static QDF_STATUS sme_passthru_request_flush(struct scheduler_msg *msg)
+{
+	sme_passthru_request_dispose_msg(msg, QDF_STATUS_E_ABORTED);
+	return QDF_STATUS_SUCCESS;
+}
+
+QDF_STATUS sme_passthru_request_submit(mac_handle_t mac_handle,
+		struct wlan_objmgr_vdev *vdev,
+		enum sme_passthru_request_action action, const uint8_t *bssid,
+		struct sme_passthru_request **out)
+{
+	struct mac_context *mac = MAC_CONTEXT(mac_handle);
+	struct sme_passthru_request *request;
+	struct scheduler_msg msg = {0};
+	QDF_STATUS status;
+
+	if (!out || *out || !mac || !vdev ||
+	    (action != SME_PASSTHRU_REQUEST_CREATE &&
+	     action != SME_PASSTHRU_REQUEST_DELETE) ||
+	    (action == SME_PASSTHRU_REQUEST_CREATE && !bssid))
+		return QDF_STATUS_E_INVAL;
+	status = wlan_objmgr_vdev_try_get_ref(vdev, WLAN_LEGACY_MAC_ID);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	if (wlan_vdev_get_psoc(vdev) != mac->psoc ||
+	    wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE) {
+		status = QDF_STATUS_E_INVAL;
+		goto release_vdev;
+	}
+	request = qdf_mem_malloc(sizeof(*request));
+	if (!request) {
+		status = QDF_STATUS_E_NOMEM;
+		goto release_vdev;
+	}
+	qdf_mem_zero(request, sizeof(*request));
+	status = qdf_event_create(&request->completion);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		qdf_mem_free(request);
+		goto release_vdev;
+	}
+	qdf_spinlock_create(&request->lock);
+	qdf_atomic_init(&request->refs);
+	qdf_atomic_set(&request->refs, 2); /* caller + reserved queue ownership */
+	request->phase = SME_PASSTHRU_QUEUED;
+	request->input.vdev = vdev;
+	request->input.psoc = mac->psoc;
+	request->input.vdev_id = wlan_vdev_get_id(vdev);
+	request->input.action = action;
+	if (bssid)
+		qdf_mem_copy(request->input.bssid, bssid, 6);
+	msg.type = action == SME_PASSTHRU_REQUEST_CREATE ?
+		eWNI_SME_PASSTHRU_CREATE_REQUEST : eWNI_SME_PASSTHRU_DELETE_REQUEST;
+	msg.bodyptr = request;
+	msg.flush_callback = sme_passthru_request_flush;
+	status = sme_acquire_global_lock(&mac->sme);
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		if (!SME_IS_START(mac) || mac->sme.passthru_requests_closed) {
+			status = QDF_STATUS_E_ABORTED;
+		} else {
+			request->queue_mac = mac;
+			qdf_atomic_inc(&mac->sme.passthru_queue_refs);
+			status = scheduler_post_message(QDF_MODULE_ID_SME,
+					QDF_MODULE_ID_PE, QDF_MODULE_ID_PE, &msg);
+		}
+		sme_release_global_lock(&mac->sme);
+	}
+	if (QDF_IS_STATUS_ERROR(status)) {
+		/* Failed post never transfers the reserved queue reference. */
+		sme_passthru_request_dispose_msg(&msg, status);
+		sme_passthru_request_put(request);
+		return status;
+	}
+	/* PE may already have completed; the caller reference still protects it. */
+	*out = request;
+	return QDF_STATUS_SUCCESS;
+release_vdev:
+	wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_MAC_ID);
+	return status;
+}
+/* END PASSTHRU OWNED REQUEST IMPLEMENTATION */
