+static void wma_pt_set_tx_ready_locked(struct wma_pt_peer_state *slot,
+				       bool ready)
+{
+	if (slot->tx_ready == ready)
+		return;
+	WRITE_ONCE(slot->tx_ready, ready);
+	if (ready)
+		atomic_inc(&wma_pt_tx_ready_count);
+	else
+		atomic_dec(&wma_pt_tx_ready_count);
+}
