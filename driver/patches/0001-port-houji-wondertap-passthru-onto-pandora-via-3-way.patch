+    uint8_t hdr[23] = {0};
+    unsigned int len = metadata ? 23 : 14;
+    unsigned int flags_offset = metadata ? 16 : 8;
+    uint16_t chan_flags = 0;
+    uint32_t present = (1U << IEEE80211_RADIOTAP_FLAGS) |
+                      (1U << IEEE80211_RADIOTAP_CHANNEL);
+    uint8_t *data;
