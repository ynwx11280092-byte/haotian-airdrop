+/* Compare with the target HAL size API; generic DP does not own TLV layout. */
+static inline bool
+hal_rx_passthru_tlv_size_valid(hal_soc_handle_t hal_soc_hdl, uint16_t size)
+{
+	struct hal_soc *hal_soc = (struct hal_soc *)hal_soc_hdl;
+	uint16_t data_size = 0, mon_size = 0;
+
+	if (!hal_soc || !hal_soc->ops || !hal_soc->ops->hal_rx_get_tlv_size)
+		return false;
+	hal_rx_get_tlv_size(hal_soc_hdl, &data_size, &mon_size);
+	return data_size && size == data_size;
+}
+
+/* Diagnostic-only layout: measured full kiwi_v2 TLV, never compact TLV.
+ * Stage39 matched 169 RX frames to these fields. The stable counter rate was
+ * 960000345 Hz; signed USER_RSSI was -67..-28. This is NOT the Samsung
+ * host-QTIMER/noise-floor fallback. Other layouts fail closed.
+ */
+static inline bool
+hal_rx_passthru_kiwi_metadata(hal_soc_handle_t hal_soc_hdl, uint8_t *buf,
+                            uint16_t size, uint64_t *ticks, int8_t *signal)
+{
+#if defined(CONFIG_WORD_BASED_TLV) || !defined(QCA_WIFI_KIWI_V2)
+    return false;
+#else
+    struct hal_soc *hal_soc = (struct hal_soc *)hal_soc_hdl;
+    uint32_t hi, lo;
+    uint16_t ppdu_end, ppdu_start;
+    uint8_t raw;
+
+    if (!hal_soc || !buf || !ticks || !signal || size != 272 ||
+        hal_soc->target_type != TARGET_TYPE_KIWI || !hal_soc->ops ||
+        !hal_soc->ops->hal_rx_tlv_get_rssi ||
+        !hal_rx_passthru_tlv_size_valid(hal_soc_hdl, size))
+        return false;
+    qdf_mem_copy(&hi, buf + 104, sizeof(hi));
+    qdf_mem_copy(&lo, buf + 112, sizeof(lo));
+    qdf_mem_copy(&ppdu_end, buf + 10, sizeof(ppdu_end));
+    qdf_mem_copy(&ppdu_start, buf + 190, sizeof(ppdu_start));
+    raw = (uint8_t)hal_soc->ops->hal_rx_tlv_get_rssi(buf);
+    *ticks = ((uint64_t)qdf_le32_to_cpu(hi) << 32) | qdf_le32_to_cpu(lo);
+    *signal = (int8_t)raw;
+    return *ticks && ppdu_end == ppdu_start && *signal < 0 && *signal != -128;
+#endif
+}
+
+/* Raw USER_RSSI byte only: no implied dBm calibration or noise floor. */
+static inline bool
+hal_rx_tlv_get_user_rssi_checked(hal_soc_handle_t hal_soc_hdl,
+				uint8_t *buf, uint8_t *rssi)
+{
+	struct hal_soc *hal_soc = (struct hal_soc *)hal_soc_hdl;
+
+	if (!hal_soc || !buf || !rssi || !hal_soc->ops ||
+	    !hal_soc->ops->hal_rx_tlv_get_rssi)
+		return false;
+	*rssi = (uint8_t)hal_soc->ops->hal_rx_tlv_get_rssi(buf);
+	return true;
+}
+#endif
+
 #endif /* _HAL_RX_H */
