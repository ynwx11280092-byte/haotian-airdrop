diff --git a/qca-wifi-host-cmn/dp/inc/cdp_txrx_cmn.h b/qca-wifi-host-cmn/dp/inc/cdp_txrx_cmn.h
index 60a5f11..f616519 100644
--- a/qca-wifi-host-cmn/dp/inc/cdp_txrx_cmn.h
+++ b/qca-wifi-host-cmn/dp/inc/cdp_txrx_cmn.h
@@ -1095,6 +1095,174 @@ cdp_vdev_register(ol_txrx_soc_handle soc, uint8_t vdev_id,
 							 osif_vdev, txrx_ops);
 }
 
+#ifdef DRIVER_PASSTHRU_DP
+/**
+ * cdp_passthru_register() - one-shot raw datapath registration
+ *
+ * Caller serializes vdev control operations and retains osif_vdev through
+ * the final one-argument vdev_del_notify, including close/detach failures.
+ * RX callback consumes its single nbuf on EVERY return value. It must not
+ * retain the callback context asynchronously without its own lifetime guard.
+ * Failure publishes nothing and leaves txrx_ops unchanged. Success may be
+ * followed immediately by RX, before this function returns. Only tx.tx is
+ * supported; fast, exception and OSRTP transmit are deliberately unavailable.
+ * freq is metadata for a channel already configured by the control layer;
+ * it does not program firmware or authorize a regulatory channel.
+ */
+static inline QDF_STATUS
+cdp_passthru_register(ol_txrx_soc_handle soc, uint8_t vdev_id,
+		     ol_osif_vdev_handle osif_vdev,
+		     struct ol_txrx_ops *txrx_ops, uint16_t freq)
+{
+	if (!soc || !soc->ops || !osif_vdev || !txrx_ops)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_register)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_register(soc, vdev_id,
+						osif_vdev, txrx_ops, freq);
+}
+
+/* Sticky close. E_BUSY requires retry; SUCCESS is not a hardware drain.
+ * Context may be freed only after the final delete notification, not here.
+ * Missing vdev is an error, never an authorization to release context.
+ */
+static inline QDF_STATUS
+cdp_passthru_close(ol_txrx_soc_handle soc, uint8_t vdev_id)
+{
+	if (!soc || !soc->ops)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops || !soc->ops->cmn_drv_ops->passthru_close)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_close(soc, vdev_id);
+}
+#endif
+
+#ifdef DRIVER_PASSTHRU_OWNER
+/* Managed ownership is opt-in. No ordinary vdev or legacy callback ABI is
+ * changed. The control owner serializes bind/close/detach/join, keeps soc,
+ * pdev and driver code alive, and stops new handle users and waits for every
+ * managed_tx call to RETURN before join. No bare-pointer concurrent-free
+ * guarantee is provided. No spinlock/RTNL/component lock may span join.
+ *
+ * Bind holds a real vdev reference until join. It may deliver RX before
+ * returning, so context must already be usable. On failure nothing is
+ * published, ops and *out are unchanged. *out must initially be NULL.
+ * On success use managed_tx only: ops->tx.tx is NULL. RX consumes its nbuf
+ * on every return value, just as the separate legacy PASSTHRU API does.
+ *
+ * Close is sticky and reports E_BUSY while synchronous users remain.
+ * Join does NOT initiate MLME/CDP detach. After a successful real detach,
+ * E_BUSY retains handle/context/parents for retry. SUCCESS synchronously
+ * releases the final guard, runs the existing finalizer and both callbacks,
+ * waits for their RETURN, then frees handle and sets *inout=NULL. The notify
+ * callback must not free the owner's only context reference or recurse into
+ * teardown; callback-local signals do not authorize earlier destruction.
+ * Neither close nor join drains firmware/DMA, IRQ/NAPI, other ref-put caller
+ * tails, or pins soc/pdev/module code. Those remain the outer owner's duty.
+ */
+/* Close is sticky for this soc epoch. SUCCESS from status means that
+ * all admitted PASS vdev allocations have been freed and both legacy delete
+ * callbacks have returned, including failed creates that never bound an owner.
+ * It does not drain firmware/DMA, WMA parameters, ref-put caller tails or
+ * release owner handles, and does not pin soc/pdev/module lifetime.
+ */
+static inline QDF_STATUS
+cdp_passthru_recovery_close(ol_txrx_soc_handle soc)
+{
+	if (!soc || !soc->ops)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_recovery_close)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_recovery_close(soc);
+}
+
+static inline QDF_STATUS
+cdp_passthru_recovery_status(ol_txrx_soc_handle soc, uint32_t *pending)
+{
+	if (!soc || !soc->ops || !pending)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_recovery_status)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_recovery_status(soc, pending);
+}
+
+static inline QDF_STATUS
+cdp_passthru_managed_bind(ol_txrx_soc_handle soc, uint8_t vdev_id,
+		ol_osif_vdev_handle osif_vdev, struct ol_txrx_ops *ops,
+		uint16_t freq, struct cdp_passthru_handle **out)
+{
+	if (!soc || !soc->ops || !out || *out || !osif_vdev || !ops)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_bind)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_managed_bind(soc, vdev_id,
+						osif_vdev, ops, freq, out);
+}
+
+
+/* Same retained handle as bind/close; callers serialize control operations. */
+static inline QDF_STATUS
+cdp_passthru_managed_pause(ol_txrx_soc_handle soc,
+			  struct cdp_passthru_handle *handle)
+{
+	if (!soc || !soc->ops || !soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_pause)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_managed_pause(soc, handle);
+}
+
+static inline QDF_STATUS
+cdp_passthru_managed_set_channel(ol_txrx_soc_handle soc,
+				struct cdp_passthru_handle *handle,
+				uint16_t frequency)
+{
+	if (!soc || !soc->ops || !soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_set_channel)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_managed_set_channel(soc,
+								handle, frequency);
+}
+
+static inline QDF_STATUS
+cdp_passthru_managed_close(ol_txrx_soc_handle soc,
+			 struct cdp_passthru_handle *handle)
+{
+	if (!soc || !soc->ops || !handle)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_close)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_managed_close(soc, handle);
+}
+
+static inline QDF_STATUS
+cdp_passthru_managed_join(ol_txrx_soc_handle soc,
+			struct cdp_passthru_handle **inout)
+{
+	if (!soc || !soc->ops || !inout || !*inout)
+		return QDF_STATUS_E_INVAL;
+	if (!soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_join)
+		return QDF_STATUS_E_NOSUPPORT;
+	return soc->ops->cmn_drv_ops->passthru_managed_join(soc, inout);
+}
+
+/* NULL means consumed; non-NULL returns the unconsumed original nbuf. */
+static inline qdf_nbuf_t
+cdp_passthru_managed_tx(ol_txrx_soc_handle soc,
+		      struct cdp_passthru_handle *handle, qdf_nbuf_t nbuf)
+{
+	if (!soc || !soc->ops || !handle || !soc->ops->cmn_drv_ops ||
+	    !soc->ops->cmn_drv_ops->passthru_managed_tx)
+		return nbuf;
+	return soc->ops->cmn_drv_ops->passthru_managed_tx(soc, handle, nbuf);
+}
+#endif
+
 static inline int
 cdp_mgmt_send(ol_txrx_soc_handle soc, uint8_t vdev_id,
 	      qdf_nbuf_t tx_mgmt_frm,	uint8_t type)
