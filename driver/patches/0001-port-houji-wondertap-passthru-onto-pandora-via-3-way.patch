+	if (!nbuf || !out || qdf_nbuf_headroom(nbuf) < QDF_WONDER_TX_META_LEN)
+		return QDF_STATUS_E_INVAL;
+	wire = qdf_nbuf_data(nbuf) - QDF_WONDER_TX_META_LEN;
+	if (wire[0] > 1)
+		return QDF_STATUS_E_INVAL;
+	out->is_unicast = wire[0];
+	out->frame_type = wire[1];
+	out->tid = wire[2];
