+#ifdef DRIVER_PASSTHRU_OWNER
+uint32_t lim_passthru_purge_deferred(struct mac_context *mac)
+{
+	struct scheduler_msg *slot;
+	struct scheduler_msg msg;
+	uint16_t start = mac->lim.gLimDeferredMsgQ.read;
+	uint16_t write = start;
+	uint16_t kept = 0;
+	uint32_t purged = 0;
+
+	/* Single stopped-worker owner: compact in FIFO order without reposting.
+	 * A destination is never ahead of an unread source in logical order.
+	 */
+	while ((slot = lim_read_deferred_msg_q(mac)) != NULL) {
+		msg = *slot;
+		qdf_mem_zero(slot, sizeof(*slot));
+		if (sme_passthru_request_dispose_msg(&msg, QDF_STATUS_E_ABORTED)) {
+			purged++;
+			continue;
+		}
+		mac->lim.gLimDeferredMsgQ.deferredQueue[write] = msg;
+		write = (write + 1) % MAX_DEFERRED_QUEUE_LEN;
+		kept++;
+	}
+	mac->lim.gLimDeferredMsgQ.read = start;
+	mac->lim.gLimDeferredMsgQ.write = write;
+	mac->lim.gLimDeferredMsgQ.size = kept;
+	return purged;
+}
+#endif
