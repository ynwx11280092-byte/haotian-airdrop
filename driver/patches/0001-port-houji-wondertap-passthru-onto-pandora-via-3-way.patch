+#ifdef DRIVER_PASSTHRU_OWNER
+QDF_STATUS lim_passthru_force_purge(struct mac_context *mac,
+		struct sme_passthru_purge_result *result)
+{
+	struct pe_session *session;
+	QDF_STATUS status;
+	uint16_t i;
+
+	if (!mac || !result)
+		return QDF_STATUS_E_INVAL;
+	qdf_mem_zero(result, sizeof(*result));
+	/* A lock failure may also return BUSY without writing the count. */
+	result->outstanding = ~0U;
+	status = sme_passthru_requests_drain_status(MAC_HANDLE(mac), &result->outstanding);
+	if (result->outstanding == ~0U ||
+	    (status != QDF_STATUS_SUCCESS && status != QDF_STATUS_E_BUSY))
+		return status;
+	result->requests = lim_passthru_purge_deferred(mac);
+	/* Do not delete sessions while an uncollected scheduler/handler tail
+	 * remains. The external worker fence is mandatory even if count is 0.
+	 */
+	status = sme_passthru_requests_drain_status(MAC_HANDLE(mac), &result->outstanding);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	if (!mac->lim.gpSession)
+		return QDF_STATUS_SUCCESS;
+	for (i = 0; i < mac->lim.maxBssId; i++) {
+		session = &mac->lim.gpSession[i];
+		if (!session->valid || !LIM_IS_PASSTHRU_ROLE(session))
+			continue;
+		/* Host-only forced cleanup: firmware is already stopped. */
+		pe_delete_session(mac, session);
+		result->sessions++;
+	}
+	return QDF_STATUS_SUCCESS;
+}
+#endif
