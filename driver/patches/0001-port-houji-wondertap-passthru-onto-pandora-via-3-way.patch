+	spin_lock_irqsave(&pt_ast_selection_lock, flags);
+	s = pt_ast_selection;
+	spin_unlock_irqrestore(&pt_ast_selection_lock, flags);
+	return scnprintf(buf, PAGE_SIZE,
+		"valid=%u vdev=%u bss_index=%u bss_hash=%u remote_index=%u remote_hash=%u selected_index=%u selected_hash=%u selected_cache_set=%u hash_override=%u\n",
+		s.valid, s.vdev_id, s.bss_index, s.bss_hash,
+		s.remote_index, s.remote_hash, s.selected_index, s.selected_hash,
+		s.selected_hash & 0xf, pt_remote_hash_override);
+}
