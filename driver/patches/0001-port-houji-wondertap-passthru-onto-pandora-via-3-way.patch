+
+QDF_STATUS wma_passthru_reap_failed_deletes(void)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct scheduler_ctx *sched = scheduler_get_context();
+	struct wma_txrx_node *iface;
+	struct del_vdev_params *param;
+	struct wlan_objmgr_vdev *vdev;
+	QDF_STATUS status;
+	uint32_t pending = 0;
+	uint16_t i;
+	bool holds;
+	bool blocked = false;
+
+	if (!wma || !wma->interfaces || !wma->wmi_handle ||
+	    !cds_get_context(QDF_MODULE_ID_SME))
+		return QDF_STATUS_E_INVAL;
+	if (!sched || sched->sch_thread || !wmi_is_blocked(wma->wmi_handle))
+		return QDF_STATUS_E_BUSY;
+	/* A delayed/asynchronous destructor needs an outer ref-put-tail join.
+	 * Never infer that join from a later callback or a cleared interface.
+	 */
+	if (wma->passthru_reap_vdev ||
+	    qdf_atomic_read(&wma->passthru_reap_state) != WMA_PT_REAP_IDLE)
+		return QDF_STATUS_E_BUSY;
+	for (i = 0; i < wma->max_bssid; i++)
+		blocked |= wma->interfaces[i].passthru_detach_blocked;
+	if (!blocked)
+		return QDF_STATUS_SUCCESS;
+	status = cdp_passthru_recovery_status(
+				cds_get_context(QDF_MODULE_ID_SOC), &pending);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	/* WMI work is synchronously joined by CDS before this entry. Existing
+	 * hold parameters remain owned until their normal path consumes them.
+	 */
+	qdf_spin_lock_bh(&wma->wma_hold_req_q_lock);
+	holds = qdf_list_size(&wma->wma_hold_req_queue) != 0;
+	qdf_spin_unlock_bh(&wma->wma_hold_req_q_lock);
+	if (holds)
+		return QDF_STATUS_E_BUSY;
+
+	/* Preflight the whole batch before releasing any WMA/SME reference. */
+	for (i = 0; i < wma->max_bssid; i++) {
+		iface = &wma->interfaces[i];
+		if (!iface->passthru_detach_blocked)
+			continue;
+		param = iface->del_staself_req;
+		if (!param || !wma_is_passthru_vdev(param->vdev) ||
+		    param->vdev_id != i || wlan_vdev_get_id(param->vdev) != i ||
+		    param->vdev->obj_state != WLAN_OBJ_STATE_LOGICALLY_DELETED ||
+		    (iface->vdev && iface->vdev != param->vdev) ||
+		    iface->is_del_sta_deferred)
+			return QDF_STATUS_E_INVAL;
+		status = wma_passthru_reap_timer_fence(wma, i);
+		if (QDF_IS_STATUS_ERROR(status))
+			return status;
+	}
+	for (i = 0; i < wma->max_bssid; i++) {
+		iface = &wma->interfaces[i];
+		if (!iface->passthru_detach_blocked)
+			continue;
+		param = iface->del_staself_req;
+		vdev = param->vdev; /* SME's outstanding reference still pins it. */
+		WRITE_ONCE(wma->passthru_reap_vdev, vdev);
+		WRITE_ONCE(wma->passthru_reap_task, current);
+		qdf_atomic_set(&wma->passthru_reap_state, WMA_PT_REAP_ARMED);
+		/* Transfer once, BEFORE any release can reenter the destructor. */
+		iface->del_staself_req = NULL;
+		iface->passthru_detach_blocked = false;
+		if (iface->vdev)
+			wma_release_vdev_ref(iface);
+		/* Return value is the historical delete error, not a failed free. */
+		sme_vdev_self_peer_delete_resp(param);
+		if (qdf_atomic_read(&wma->passthru_reap_state) !=
+		    WMA_PT_REAP_SYNC_DONE)
+			return QDF_STATUS_E_BUSY;
+		/* Same-task destructor and its caller tail returned with consumer. */
+		WRITE_ONCE(wma->passthru_reap_vdev, NULL);
+		WRITE_ONCE(wma->passthru_reap_task, NULL);
+		qdf_atomic_set(&wma->passthru_reap_state, WMA_PT_REAP_IDLE);
+	}
+	return QDF_STATUS_SUCCESS;
+}
