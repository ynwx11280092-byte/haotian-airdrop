+#ifdef DRIVER_PASSTHRU_DP
+/* Caller owns a vdev reference until after exit; never wait under this lock. */
+static inline bool dp_passthru_enter(struct dp_vdev *vdev)
+{
+	bool accepted = false;
+
+	qdf_spin_lock_bh(&vdev->passthru_lock);
+	if (vdev->passthru_state == DP_PASSTHRU_ACTIVE &&
+	    !vdev->passthru_paused) {
+		vdev->passthru_users++;
+		accepted = true;
+	}
+	qdf_spin_unlock_bh(&vdev->passthru_lock);
+	return accepted;
+}
+
+static inline void dp_passthru_exit(struct dp_vdev *vdev)
+{
+	qdf_spin_lock_bh(&vdev->passthru_lock);
+	QDF_ASSERT(vdev->passthru_users);
+	vdev->passthru_users--;
+	qdf_spin_unlock_bh(&vdev->passthru_lock);
+}
+
+/* SUCCESS means CPU callers exited, NOT firmware/DMA completion. */
+static inline QDF_STATUS dp_passthru_close_gate(struct dp_vdev *vdev,
+					      bool detach)
+{
+	QDF_STATUS status = QDF_STATUS_SUCCESS;
+
+	qdf_spin_lock_bh(&vdev->passthru_lock);
+	if (vdev->passthru_state == DP_PASSTHRU_DETACHING) {
+		status = QDF_STATUS_E_BUSY;
+	} else {
+		vdev->passthru_state = DP_PASSTHRU_CLOSING;
+		if (vdev->passthru_users)
+			status = QDF_STATUS_E_BUSY;
+		else if (detach)
+			vdev->passthru_state = DP_PASSTHRU_DETACHING;
+	}
+	qdf_spin_unlock_bh(&vdev->passthru_lock);
+	return status;
+}
+#endif
