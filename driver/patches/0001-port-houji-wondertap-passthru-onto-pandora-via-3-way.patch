+QDF_STATUS wma_passthru_vdev_stop_send(struct vdev_mlme_obj *mlme,
+				      uint16_t data_len, void *data)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wlan_objmgr_vdev *vdev = mlme->vdev;
+	uint8_t vdev_id = wlan_vdev_get_id(vdev);
+	QDF_STATUS status;
+
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_stop_send_begin(&mlme->passthru_stop);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	status = wma ? wma_send_vdev_stop_to_fw(wma, vdev_id) : QDF_STATUS_E_INVAL;
+	wlan_vdev_obj_lock(vdev);
+	wlan_pt_stop_send_end(&mlme->passthru_stop, status);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		sme_post_passthrough_event(vdev_id, SIR_PASSTHRU_STOP_RESPONSE, status);
+		wlan_vdev_mlme_sm_deliver_evt(vdev, WLAN_VDEV_SM_EV_STOP_FAIL, 0, NULL);
+	}
+	return status;
+}
+
+QDF_STATUS wma_passthru_vdev_stop_resp(struct vdev_mlme_obj *mlme,
+				      struct vdev_stop_response *rsp)
+{
+	struct wlan_objmgr_vdev *vdev = mlme->vdev;
+	uint8_t vdev_id = wlan_vdev_get_id(vdev);
+	QDF_STATUS status;
+
+	if (!rsp || rsp->vdev_id != vdev_id)
+		return QDF_STATUS_E_INVAL;
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_stop_response_begin(&mlme->passthru_stop, rsp->status);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status; /* Duplicate/unarmed/failed epoch: no SM mutation. */
+	sme_post_passthrough_event(vdev_id, SIR_PASSTHRU_STOP_RESPONSE, rsp->status);
+	status = wlan_vdev_mlme_sm_deliver_evt(vdev,
+		QDF_IS_STATUS_SUCCESS(rsp->status) ? WLAN_VDEV_SM_EV_MLME_DOWN_REQ :
+		WLAN_VDEV_SM_EV_STOP_FAIL, 0, NULL);
+	/* Includes nested DOWN submission and state-machine callback tails.
+	 * The target-if caller still holds its own object reference on return.
+	 */
+	wlan_vdev_obj_lock(vdev);
+	wlan_pt_stop_response_end(&mlme->passthru_stop, status);
+	wlan_vdev_obj_unlock(vdev);
+	return status;
+}
+
+QDF_STATUS wma_passthru_vdev_down_send(struct vdev_mlme_obj *mlme,
+				      uint16_t data_len, void *data)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wlan_objmgr_vdev *vdev = mlme->vdev;
+	uint8_t vdev_id = wlan_vdev_get_id(vdev);
+	QDF_STATUS status, transition;
+
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_stop_down_begin(&mlme->passthru_stop);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+	status = wma ? wma_send_vdev_down_to_fw(wma, vdev_id) : QDF_STATUS_E_INVAL;
+	transition = wlan_vdev_mlme_sm_deliver_evt(vdev,
+		QDF_IS_STATUS_SUCCESS(status) ? WLAN_VDEV_SM_EV_DOWN_COMPLETE :
+		WLAN_VDEV_SM_EV_DOWN_FAIL, 0, NULL);
+	wlan_vdev_obj_lock(vdev);
+	wlan_pt_stop_down_end(&mlme->passthru_stop, status, transition);
+	wlan_vdev_obj_unlock(vdev);
+	sme_post_passthrough_event(vdev_id, SIR_PASSTHRU_DOWN_SUBMITTED, status);
+	return QDF_IS_STATUS_ERROR(status) ? status : transition;
+}
+
+void wma_passthru_vdev_init_down(struct vdev_mlme_obj *mlme)
+{
+	wlan_vdev_obj_lock(mlme->vdev);
+	wlan_pt_stop_already_down(&mlme->passthru_stop);
+	wlan_vdev_obj_unlock(mlme->vdev);
+	sme_post_passthrough_event(wlan_vdev_get_id(mlme->vdev),
+		SIR_PASSTHRU_ALREADY_DOWN, QDF_STATUS_SUCCESS);
+}
+
+#endif
+
