# ============================================================================
# 新机型模板：复制为 device/<codename>.env，按实机逐项核对后再打包。
# 打包时用 XOS_PROFILE=<codename> 选择配置（默认 haotian）。
# ============================================================================

PROFILE_ID=CHANGEME
DEVICE_CODENAME=CHANGEME
DEVICE_NAME="厂商 型号"
DEVICE_SOC="SoC"
DEVICE_WLAN="WLAN 芯片"
EXPECTED_SDK=37
EXPECTED_BUILD_PREFIX="OS4.0.4.0.XXXXCNXM"

EXPECTED_KERNEL=CHANGEME
KERNEL_ACCEPT="CHANGEME"
# 从手机原厂 .ko 里读 vermagic 的第一个空格之后部分（tools/preflight.sh 会打印）
EXPECTED_VERMAGIC_SUFFIX="SMP preempt mod_unload modversions aarch64"

# ?????????????STRICT_STOCK_CHECK=1 ?????????
STRICT_STOCK_CHECK=0
KNOWN_STOCK_DRIVER=
KNOWN_STOCK_DRIVER_SHA=
KNOWN_STOCK_NOTE_SHA=
KNOWN_STOCK_AMSS=
KNOWN_STOCK_AMSS_SHA=

DRIVER_CANDIDATES="qca_cld3_peach_v2 qca_cld3_peach"
DRIVER_KO_CANDIDATES="qca_cld3_peach_v2.ko qca_cld3_peach.ko"
VENDOR_DLKM_DIR=/vendor_dlkm/lib/modules
FW_CANDIDATES="/vendor/firmware_mnt/image/peach/amss20.bin /firmware/image/peach/amss20.bin"

S26U_FW_REL=firmware/s26u-amss20.bin
S26U_FW_SHA=71fc5c2eb2df048b6c4b494564cfbef730db879a3d8b4426c31ad23b5d448860
S26U_FW_SEARCH="/sdcard/Download/s26u-amss20.bin /sdcard/Download/amss20.bin /data/local/tmp/s26u-amss20.bin $RUNTIME_DIR/$S26U_FW_REL"

KERNEL_MODULES="qca_cld3_peach_v2.ko wonder.ko xos_wonder_bridge.ko xos_mhi_fw.ko"
RUNTIME_BINARIES="owly-xosd wonder-init xos-bridge.zip"
BRIDGE_MOD=xos_wonder_bridge
MHI_MOD=xos_mhi_fw
WONDER_MOD=wonder

MISHARE_PKG=com.miui.mishare.connectivity
MISHARE_VC_SUPPORTED="50401"

COMPAT_PKG=org.haotian.xoscompat
COMPAT_APK_NAME=Haotian-XOS-Compat.apk

AWDL_CHANNEL=149
ROUTE_TABLE=10074

XOS_PT_PARAMS="pt_exclusive=1 pt_zero_serial=1 pt_rx_metadata=1 pt_rx_msdu_buf=1 pt_rx_ezif_marked=1 pt_remote_multi=1 pt_remote_assoc=0 pt_remote_ast_override=1 pt_remote_hash_override=1 pt_remote_reo=2 pt_remote_rx_window=256 pt_rate_observe=1 pt_single_ring=1 pt_sync_lmac=1 pt_vendor_chan=1 pt_dynamic_rate=1 pt_vht80=1 pt_vht80_2ss=1 pt_tx_ampdu=1 pt_rx_capacity_4224=1"
XOS_PROFILE=vht80-2ss-mcs9-sgi
XOS_OWLY_MODE="amsdu ack"
