# ============================================================================
# 设备配置：小米 15 Pro（codename: haotian / 型号 2410DPN6CC）
# 目标系统：澎湃 HyperOS OS4.0.4.0.XOBCNXM，Android 17（SDK 37，中国稳定版）
# 实机采集：2026-11-22 01:59（tools/preflight.sh，设备 root/KernelSU）
# ----------------------------------------------------------------------------
# 本文件由 module/common.sh 用 POSIX sh source。只能写 KEY=value；
# 值里不要出现 `$`、反引号、`;` 等 shell 元字符（路径用绝对路径并加引号）。
# 运行时探测到的真实值会写入 /data/local/tmp/xos/owly/device.conf，
# runtime/radio.sh 只读那份生成后的配置。
# ============================================================================

PROFILE_ID=haotian
DEVICE_CODENAME=haotian
DEVICE_NAME="小米 15 Pro"
DEVICE_SOC="SM8750 (骁龙 8 Elite)"
DEVICE_WLAN="peach / FastConnect 7900"
EXPECTED_SDK=37
EXPECTED_BUILD_PREFIX="OS4.0.4.0.XOBCNXM"

# --- 内核 -------------------------------------------------------------------
# 实机 uname -r（2026-11-22，OS4.0.4.0.XOBCNXM）。
EXPECTED_KERNEL=6.6.118-android15-8-gf72a02f47f4b-abogki551678766-4k
# 允许安装/运行的内核白名单（空格分隔）。同一内核构建的其它 release 串可以追加，
# 但默认只信任上面这一条，防止 OTA 后加载错配模块。
KERNEL_ACCEPT="6.6.118-android15-8-gf72a02f47f4b-abogki551678766-4k"
# 内核模块 vermagic 的"配置后缀"（第一个空格之后的部分）。
# 开启 CONFIG_MODVERSIONS 的内核在加载模块时只比较这一段 + 符号 CRC，不比较
# UTS_RELEASE。实机原厂驱动的 vermagic 已验证为
#   "6.6.57-android15-8-4k SMP preempt mod_unload modversions aarch64" 的 UTS 部分，
# 即 Xiaomi 的 vendor 模块还是按 6.6.57 树编的、但能加载到 6.6.118 内核上 —— 正是
# 上述机制在起作用。完整后缀见 build/phone/preflight-v2.txt（preflight v2 输出）。
EXPECTED_VERMAGIC_SUFFIX="SMP preempt mod_unload modversions aarch64"

# --- 原厂 WLAN 驱动（实机已确认） -----------------------------------------
DRIVER_CANDIDATES="qca_cld3_peach_v2 qca_cld3_peach"
DRIVER_KO_CANDIDATES="qca_cld3_peach_v2.ko qca_cld3_peach.ko"
VENDOR_DLKM_DIR=/vendor_dlkm/lib/modules

# --- 原厂 WLAN 固件（实机已确认） -----------------------------------------
# 注意：原厂固件 amss20.bin 只有 6,930,496 字节，比三星 S26U 的 7,364,672 字节小
# 434,176 字节 —— 会话期间换用 S26U 固件时 MHI 的 FBC 缓冲区会不够，因此
# xos_mhi_fw.ko 在本机是**必须**的（不能走"固件不更大就跳过"的降级路径）。
FW_CANDIDATES="/vendor/firmware_mnt/image/peach/amss20.bin /vendor/firmware_mnt/image/peach/amss.bin /firmware/image/peach/amss20.bin"

# 会话期间临时 bind mount 的三星 S26 Ultra（SM-S948B / peach）WLAN 固件。
# 它与小米原厂固件同芯片族、签名链相同；本项目不附带该文件，用户需按
# firmware/README.md 自行获取。
S26U_FW_REL=firmware/s26u-amss20.bin
S26U_FW_SHA=71fc5c2eb2df048b6c4b494564cfbef730db879a3d8b4426c31ad23b5d448860
S26U_FW_SIZE=7364672
S26U_FW_SEARCH="/sdcard/Download/s26u-amss20.bin /sdcard/Download/amss20.bin /data/local/tmp/s26u-amss20.bin $RUNTIME_DIR/$S26U_FW_REL"

# --- 实机原厂指纹（2026-11-22 采集，用于安装前的严格校验） -----------------
# 这些值来自用户实机 OS4.0.4.0.XOBCNXM；如果以后系统 OTA 改了驱动/固件，
# 安装器会拒绝安装并提示等待适配（防止把旧模块装到新系统上）。
STRICT_STOCK_CHECK=1
KNOWN_STOCK_DRIVER=qca_cld3_peach_v2
KNOWN_STOCK_DRIVER_KO=/vendor_dlkm/lib/modules/qca_cld3_peach_v2.ko
KNOWN_STOCK_DRIVER_SHA=86d56305f1eff270d552e32e525e40b967eaa95e8038cb43f89b81221494d197
KNOWN_STOCK_NOTE_SHA=ece9daf2a2a9b1fb09fc9710d7c08aa9d995d6a2ebc9395190c8c6eb3f862f80
KNOWN_STOCK_DRIVER_VERMAGIC="6.6.57-android15-8-4k SMP preempt mod_unload modversions aarch64"
KNOWN_STOCK_AMSS=/vendor/firmware_mnt/image/peach/amss20.bin
KNOWN_STOCK_AMSS_SHA=90e365a5371c7fb698943e45a0b26e60edbba17d4e9f1e5bf9fdc673538a97fc
KNOWN_STOCK_AMSS_SIZE=6930496
KNOWN_STOCK_AMSS2=/vendor/firmware_mnt/image/peach/amss.bin
KNOWN_STOCK_AMSS2_SHA=7bcdb17787027d0b9b9ba36088d554e122890feb0b6ce6c16efcdf3846e84567
KNOWN_MISHARE_VC=50500

# --- 内核模块文件名 ---------------------------------------------------------
# 前 4 个是驱动/内核模块，后 3 个是运行时。qca_cld3_peach_v2.ko 由
# driver/patches 打补丁后编译，名字要与原厂一致（wlan 加载路径/固件名依赖它）。
KERNEL_MODULES="qca_cld3_peach_v2.ko wonder.ko xos_wonder_bridge.ko xos_mhi_fw.ko rc80211_minstrel_ht.ko"
RUNTIME_BINARIES="owly-xosd wonder-init xos-bridge.zip"
BRIDGE_MOD=xos_wonder_bridge
MHI_MOD=xos_mhi_fw
WONDER_MOD=wonder
# 原厂 mac80211.ko 无内置 RC 算法；模块随包提供 rc80211_minstrel_ht.ko
MINSTREL_MOD=rc80211_minstrel_ht

# --- 小米互传（实机 5.5.0 / versionCode 50500） ---------------------------
MISHARE_PKG=com.miui.mishare.connectivity
# 已知兼容的 versionCode；不在列表里只告警（Wi-Fi 伪装仍启用，Live Photo 合成自动跳过）。
MISHARE_VC_SUPPORTED="50401 50500 50501"

# --- 兼容模块（LSPosed） ----------------------------------------------------
COMPAT_PKG=org.haotian.xoscompat
COMPAT_APK_NAME=Haotian-XOS-Compat.apk

# --- AWDL / 路由 ------------------------------------------------------------
AWDL_CHANNEL=149
ROUTE_TABLE=10074

# --- 会话参数（一般不需要改） ----------------------------------------------
XOS_PT_PARAMS="pt_exclusive=1 pt_zero_serial=1 pt_rx_metadata=1 pt_rx_msdu_buf=1 pt_rx_ezif_marked=1 pt_remote_multi=1 pt_remote_assoc=0 pt_remote_ast_override=1 pt_remote_hash_override=1 pt_remote_reo=2 pt_remote_rx_window=256 pt_rate_observe=1 pt_single_ring=1 pt_sync_lmac=1 pt_vendor_chan=1 pt_dynamic_rate=1 pt_vht80=1 pt_vht80_2ss=1 pt_tx_ampdu=1 pt_rx_capacity_4224=1"
XOS_PROFILE=vht80-2ss-mcs9-sgi
XOS_OWLY_MODE="amsdu ack"
